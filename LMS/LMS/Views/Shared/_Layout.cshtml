<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - LMS</title>

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Site Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LMS.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- NAVBAR -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-graduation-cap me-2"></i> LMS
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto">
                        @* --------- Guest --------- *@
                        @if (!User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Courses" asp-action="AllCourses">Courses</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li>
                            <li class="nav-item"><a class="btn btn-light ms-2" asp-controller="Account" asp-action="Signup">Sign Up</a></li>
                        }

                        @* --------- Student --------- *@
                        else if (User.IsInRole("Student"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Courses</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Courses" asp-action="MyCourses">My Courses</a></li>
                                    <li><a class="dropdown-item" asp-controller="Courses" asp-action="AllCourses">All Courses</a></li>
                                </ul>
                            </li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Lectures" asp-action="Index">Lectures</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Tests" asp-action="Index">Tests</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Assignments" asp-action="Index">Assignments</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Discussions" asp-action="Index">Discussions</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Certificates" asp-action="Index">Certificates</a></li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                    <i class="fa-solid fa-user"></i> Account
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Manage">Update Account</a></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="fa-solid fa-right-from-bracket"></i> Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }

                        @* --------- Instructor --------- *@
                        else if (User.IsInRole("Instructor"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Lectures" asp-action="Start">My Lecture</a></li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Courses</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Courses" asp-action="MyCourses">My Courses</a></li>
                                    <li><a class="dropdown-item" asp-controller="Courses" asp-action="AllCourses">All Courses</a></li>
                                </ul>
                            </li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Assignments" asp-action="Manage">Assignments</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Tests" asp-action="Manage">Tests</a></li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                    <i class="fa-solid fa-user"></i> Account
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Manage">Update Account</a></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="fa-solid fa-right-from-bracket"></i> Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }

                        @* --------- Admin --------- *@
                        else if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="ManageUsers">Users</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Courses" asp-action="Manage">Courses</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="System" asp-action="Settings">System Settings</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="Index">Analytics</a></li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                    <i class="fa-solid fa-user-shield"></i> Admin
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Manage">Update Account</a></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="fa-solid fa-right-from-bracket"></i> Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><span class="nav-link text-danger">Invalid User</span></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- MAIN -->
    <main class="container py-4">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="bg-light border-top py-3 mt-4">
        <div class="container d-flex justify-content-between">
            <span class="text-muted">&copy; @DateTime.Now.Year - LMS</span>
            <ul class="list-inline mb-0">
                <li class="list-inline-item"><a asp-controller="Home" asp-action="About">About</a></li>
                <li class="list-inline-item"><a asp-controller="Home" asp-action="Contact">Contact</a></li>
                <li class="list-inline-item"><a asp-controller="Home" asp-action="Help">Help</a></li>
                <li class="list-inline-item"><a asp-controller="Home" asp-action="Privacy">Privacy</a></li>
            </ul>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
