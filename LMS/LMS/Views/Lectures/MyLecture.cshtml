@model List<Lecture>

<h2>My Lectures</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Course</th>
            <th>Lecture Title</th>
            <th>Instructor</th>
            <th>Date & Time</th>
            <th>Join</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var lecture in Model)
        {
            var instructor = lecture.Instructor?.FirstName
            ?? lecture.Course.CourseInstructors.FirstOrDefault()?.Instructor?.FirstName
            ?? "Unknown";

            <tr>
                <td>@lecture.Course.Name</td>
                <td>@lecture.Title</td>
                <td>@instructor</td>
                <td>@lecture.LectureDate.ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    @if (!string.IsNullOrEmpty(lecture.MeetingLink))
                    {
                        <a href="@lecture.MeetingLink" target="_blank" class="btn btn-primary btn-sm">Join</a>
                    }
                    else
                    {
                        <span class="text-muted">No link</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

