@{
    ViewData["Title"] = "Edit Course";
}

<div class="container mt-4">
    <h2 class="mb-4">✏️ Edit Course</h2>

    <form method="post" enctype="multipart/form-data">
        <div class="row">
            <!-- Left: Course Image -->
            <div class="col-md-4">
                <label class="form-label fw-bold">Course Image</label>
                <input type="file" class="form-control" accept="image/*"/>
                <!-- Current Image Preview -->
                <img src="https://via.placeholder.com/300x200.png?text=Course+Image"
                     alt="Current Course Image"
                     class="img-fluid rounded shadow-sm mt-2" />
            </div>

            <!-- Right: Course Info -->
            <div class="col-md-8">
                <div class="mb-3">
                    <label class="form-label fw-bold">Course Name</label>
                    <input type="text" class="form-control" placeholder="Enter course name" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Description</label>
                    <textarea class="form-control" rows="4" placeholder="Enter course description"></textarea>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Rating</label>
                        <input type="number" step="0.1" class="form-control" placeholder="e.g. 4.5" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Practice Exercises</label>
                        <input type="number" class="form-control" placeholder="e.g. 10" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Total Hours</label>
                        <input type="number" class="form-control" placeholder="e.g. 40" />
                    </div>
                </div>
            </div>
        </div>

        <!-- What You'll Learn Section -->
        <section class="mt-4">
            <h4 class="mb-3">🎯 Skills (What You'll Learn)</h4>

            <div id="skills-container">
                <!-- Example Skill -->
                <div class="card mb-3 p-3">
                    <div class="row">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Skill Name</label>
                            <input type="text" class="form-control" placeholder="e.g. HTML Basics" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Lectures / Hours</label>
                            <input type="text" class="form-control" placeholder="e.g. 5 lectures (3h)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Description</label>
                            <input type="text" class="form-control" placeholder="e.g. Learn fundamentals" />
                        </div>
                    </div>
                </div>

                <!-- Another Example Skill -->
                <div class="card mb-3 p-3">
                    <div class="row">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Skill Name</label>
                            <input type="text" class="form-control" placeholder="e.g. CSS Styling" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Lectures / Hours</label>
                            <input type="text" class="form-control" placeholder="e.g. 6 lectures (4h)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Description</label>
                            <input type="text" class="form-control" placeholder="e.g. Build layouts" />
                        </div>
                    </div>
                </div>
            </div>

            <button type="button" class="btn btn-outline-primary btn-sm mt-2" id="add-skill">
                ➕ Add Skill
            </button>
        </section>

        <!-- Save/Cancel Buttons -->
        <div class="mt-4">
            <button type="submit" class="btn btn-success">💾 Save Changes</button>
            <a href="course-details.html" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
