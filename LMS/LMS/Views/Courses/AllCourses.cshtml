@model IEnumerable<LMS.Models.DataModels.Course>
@{
    ViewData["Title"] = "All Courses";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Courses</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/AllCourses.css" rel="stylesheet" />
</head>
<body>
    <div class="container mt-4">
        <div class="search-container">
            <h1 class="page-title">
                <i class="fas fa-graduation-cap me-3"></i>All Courses
            </h1>

            <div class="row">
                <div class="col-md-8 offset-md-2">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-white">
                            <i class="fas fa-search text-muted"></i>
                        </span>
                        <input type="text" id="courseSearch" class="form-control" placeholder="Search courses by name or description..." />
                        <button type="button" id="clearSearch" class="btn btn-light d-none">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                    <div id="searchResultsCount" class="search-results-count"></div>
                </div>
            </div>

            <div class="row mt-4 text-center text-white">
                <div class="col-md-3">
                    <h4 id="totalCourses">@Model.Count()</h4>
                    <small>Total Courses</small>
                </div>
                <div class="col-md-3">
                    <h4 id="freeCourses">@Model.Count(c => c.IsFree)</h4>
                    <small>Free Courses</small>
                </div>
                <div class="col-md-3">
                    <h4 id="beginnerCourses">@Model.Count(c => c.Level == LMS.Models.DataModels.Levels.Beginner)</h4>
                    <small>Beginner Courses</small>
                </div>
            </div>
        </div>

        <div id="coursesContainer">
            @if (Model.Any())
            {
                <div class="row g-4" id="coursesGrid">
                    @foreach (var course in Model)
                    {
                        <div class="col-xl-4 col-lg-6 col-md-6 course-item"
                             data-name="@course.Name.ToLower()"
                             data-description="@course.Description?.ToLower()">
                            <div class="course-card card fade-in">
                                <div class="course-image position-relative">
                                    @if (!string.IsNullOrEmpty(course.ThumbnailPath))
                                    {
                                        <img src="@course.ThumbnailPath" class="course-thumbnail" alt="@course.Name" />
                                    }
                                    else
                                    {
                                        <i class="fas fa-graduation-cap"></i>
                                    }
                                    <span class="course-level">@course.Level</span>
                                </div>

                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h5 class="card-title fw-bold course-name">@course.Name</h5>
                                        @if (course.IsFree)
                                        {
                                            <span class="course-free">FREE</span>
                                        }
                                        else
                                        {
                                            <span class="course-price">$@course.Price</span>
                                        }
                                    </div>

                                    @if (!string.IsNullOrEmpty(course.CourseCode))
                                    {
                                        <p class="text-muted small mb-2">
                                            <i class="fas fa-code me-1"></i>@course.CourseCode
                                        </p>
                                    }

                                    <p class="card-text text-muted mb-3 course-description">
                                        @if (!string.IsNullOrEmpty(course.Description))
                                        {
                                            @(course.Description.Length > 100 ? course.Description.Substring(0, 100) + "..." : course.Description)
                                        }
                                    </p>

                                    @if (course.Skills?.Any() == true)
                                    {
                                        <div class="mb-3">
                                            <div class="d-flex flex-wrap">
                                                @foreach (var CourseSkill in course.Skills.Take(3))
                                                {
                                                    <span class="skill-tag">@CourseSkill.Skill.Name</span>
                                                }
                                                @if (course.Skills.Count > 3)
                                                {
                                                    <span class="skill-tag">+@(course.Skills.Count - 3) more</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                    <div class="row mb-3">
                                        <div class="col-6">
                                            <div class="stats-item">
                                                <i class="fas fa-clock"></i>
                                                <span>@course.DurationWeeks weeks</span>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="stats-item">
                                                <i class="fas fa-language"></i>
                                                <span>@course.Language</span>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="stats-item">
                                                <i class="fas fa-star"></i>
                                                <span>@course.Credits credits</span>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="stats-item">
                                                <i class="fas fa-chalkboard-teacher"></i>
                                                <span>@course.DeliveryMode</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <small class="text-muted">
                                            <i class="fas fa-calendar me-1"></i>
                                            @course.StartDate.ToString("MMM dd, yyyy") - @course.EndDate.ToString("MMM dd, yyyy")
                                        </small>
                                    </div>

                                    <div class="action-buttons">
                                        <a asp-action="Details" asp-controller="Courses" asp-route-id="@course.Id" class="btn btn-primary btn-sm flex-fill">
                                            <i class="fas fa-eye me-1"></i>View Details
                                        </a>
                                        @if(User.IsInRole("Admin"))
                                        {
                                            <a asp-action="Edit" asp-controller="Courses" asp-route-id="@course.Id" class="btn btn-outline-secondary btn-sm">
                                                <i class="fas fa-edit"></i> Edit Course
                                            </a>
                                            <a asp-action="Delete" asp-controller="Courses" asp-route-id="@course.Id" class="btn btn-outline-danger btn-sm">
                                                <i class="fas fa-trash"></i> Delete Course
                                            </a>
                                        }
                                        
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-graduation-cap"></i>
                    <h3>No Courses Found</h3>
                    <p class="text-muted">There are no courses available at the moment.</p>
                    @if (User.IsInRole("Admin"))
                    {
                        <a href="/Courses/Create" class="btn btn-primary mt-3">
                            <i class="fas fa-plus me-2"></i>Create First Course
                        </a>
                    }
                </div>
            }
        </div>

        <div id="noResults" class="empty-state" style="display: none;">
            <i class="fas fa-search"></i>
            <h3>No Courses Found</h3>
            <p class="text-muted">No courses match your search criteria. Try different keywords.</p>
            <button id="clearSearchBtn" class="btn btn-outline-primary mt-3">
                <i class="fas fa-times me-2"></i>Clear Search
            </button>
        </div>
    </div>

    <script src="~/js/AllCourses.js"></script>
</body>
</html>