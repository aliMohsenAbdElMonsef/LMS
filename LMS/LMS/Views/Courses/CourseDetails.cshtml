@model LMS.Models.DataModels.Course

@{
    ViewData["Title"] = "Course Details";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Model.Name - Course Details</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/CourseDetails.css" rel="stylesheet">
</head>
<body>
    <!-- Hero Section -->
    <section class="hero-section py-5 bg-light">
        <div class="container">
            <div class="row align-items-center hero-content">
                <div class="col-lg-6">
                    <h1 class="course-title">@Model.Name</h1>
                </div>
                <div class="col-lg-6 text-center">
                    <div class="course-image">
                        <img src="@Url.Action("GetCoursePhoto", "Course", new { id = Model.Id })"
                             alt="@Model.Name" class="img-fluid rounded shadow" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Content -->
    <section class="main-content py-5">
        <div class="container">
            <div class="row">
                <!-- Course Details -->
                <div class="col-lg-8">
                    <div class="content-card mb-4 p-4 shadow-sm rounded bg-white">
                        <h2><i class="fas fa-info-circle"></i> Course Description</h2>
                        <p>@Model.Description</p>
                    </div>

                    <!-- Prerequisites -->
                    <div class="content-card mb-4 p-4 shadow-sm rounded bg-white">
                        <h2><i class="fas fa-list-check"></i> Prerequisites</h2>
                        @if (Model.Prerequisites.Any())
                        {
                            <ul>
                                @foreach (var pre in Model.Prerequisites)
                                {
                                    <li>@pre.PrerequisiteCourse.Name</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p>None</p>
                        }
                    </div>

                    <!-- Course Content / Skills -->
                    <div class="content-card mb-4 p-4 shadow-sm rounded bg-white">
                        <h2><i class="fas fa-book-open"></i> What Will You Learn</h2>
                        @if (Model.Skills.Any())
                        {
                            <div class="row">
                                @foreach (var CourseSkill in Model.Skills)
                                {
                                    <div class="col-md-6 mb-3">
                                        <div class="feature-item border rounded p-3 h-100">
                                            <h5>@CourseSkill.Skill.Name</h5>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p>No skills added yet.</p>
                        }
                    </div>
                </div>

                <!-- Sidebar -->
                <div class="col-lg-4">
                    <div class="content-card mb-4 p-4 shadow-sm rounded bg-white">
                        <h3><i class="fas fa-info"></i> Course Info</h3>
                        <ul class="list-unstyled">
                            <li class="mb-2">
                                <i class="fas fa-dollar-sign"></i>
                                Price: @Model.Price.ToString("C")
                            </li>
                            <li class="mb-2">
                                <i class="fas fa-user-tie"></i>
                                Instructor(s):
                                @if (Model.CourseInstructors.Any())
                                {
                                    @foreach (var ci in Model.CourseInstructors)
                                    {
                                        @($"{ci.Instructor.FirstName} {ci.Instructor.LastName}")
                                
                                        <br />
                                    }
                                }
                                else
                                {
                                    <span>None specified</span>
                                }
                            </li>
                            @* <li class="mb-2">
                                <i class="fas fa-users"></i>
                                Enrollment: @Model.EnrolledCount
                            </li>
                            <li class="mb-2">
                                <i class="fas fa-star"></i>
                                Rating: @Model.Rating / 5 (@Model.RatingCount reviews)
                            </li>
                            <li class="mb-2">
                                <i class="fas fa-calendar"></i>
                                Last Updated: @Model.LastUpdate.ToString("MMMM yyyy")
                            </li> *@
                            <li>
                                <i class="fas fa-certificate"></i>
                                Certificate: Completion Certificate Included
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>
</body>
</html>
