@using System.Text.Json
@model LMS.Models.ViewModels.CreateCourseViewModel

@{
    ViewData["Title"] = "Create Course";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create New Course</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/CreateCourse.css" rel="stylesheet">
</head>
<body>
    <div class="main-container fade-in">
        <div class="header-section">
            <h1><i class="fas fa-graduation-cap"></i> Create New Course</h1>
        </div>

        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div class="form-container">
                <h2 class="section-title"><i class="fas fa-info-circle"></i> Basic Information</h2>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Course Name</label>
                        <input asp-for="Name" class="form-control" placeholder="Enter course name" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Course Code</label>
                        <input asp-for="CourseCode" class="form-control" placeholder="Optional code" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter description"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Credits</label>
                        <input asp-for="Credits" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Level</label>
                        <select asp-for="Level" class="form-select">
                            <option value="">Select Level</option>
                            @foreach (var level in Enum.GetValues(typeof(LMS.Models.DataModels.Levels)))
                            {
                                <option value="@level">@level</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Language</label>
                        <input asp-for="Language" class="form-control" />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Start Date</label>
                        <input asp-for="StartDate" type="date" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">End Date</label>
                        <input asp-for="EndDate" type="date" class="form-control" />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Duration Weeks</label>
                        <input asp-for="DurationWeeks" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Category</label>
                        <select asp-for="CategoryId" class="form-select" required>
                            <option value="">Select Category</option>
                            @foreach (var category in Model.AllCategories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-container">
                <h2 class="section-title"><i class="fas fa-dollar-sign"></i> Pricing & Delivery</h2>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Price</label>
                        <input asp-for="Price" class="form-control" id="priceInput" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Is Free?</label>
                        <div class="form-check form-switch mt-2">
                            <input asp-for="IsFree" type="checkbox" class="form-check-input" id="isFreeCheckbox" style="width: 3em; height: 1.5em;" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Delivery Mode</label>
                        <select asp-for="DeliveryMode" class="form-select">
                            @foreach (var mode in Enum.GetValues(typeof(LMS.Models.DataModels.DeliveryMode)))
                            {
                                <option value="@mode">@mode</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-container">
                <h2 class="section-title"><i class="fas fa-list-check"></i> Skills</h2>

                <div class="mb-4">
                    <label class="form-label fw-bold">Search and Select Skills</label>

                    <div class="input-group mb-3">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input type="text" id="skillSearch" class="form-control" placeholder="Type to search skills..." />
                    </div>

                    <div id="searchResults" class="border rounded bg-white">
                    </div>

                    <div id="selectedSkills" class="mt-3">
                        <label class="form-label fw-bold">Selected Skills:</label>
                        <div id="selectedSkillsList" class="d-flex flex-wrap gap-2 mt-2">
                            <div class="text-muted">No skills selected yet</div>
                        </div>
                    </div>

                    <select asp-for="SelectedSkillIds" multiple style="display: none;" id="selectedSkillIds">
                        @foreach (var skill in Model.AllSkills)
                        {
                            <option value="@skill.Id">@skill.Name</option>
                        }
                    </select>
                </div>
            </div>

            <div class="form-container">
                <h2 class="section-title"><i class="fas fa-sitemap"></i> Prerequisites</h2>

                <div class="mb-4">
                    <label class="form-label fw-bold">Search and Select Prerequisite Courses</label>

                    <div class="input-group mb-3">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input type="text" id="prerequisiteSearch" class="form-control" placeholder="Type to search courses..." />
                    </div>

                    <div id="prerequisiteSearchResults" class="border rounded bg-white">
                    </div>

                    <div id="selectedPrerequisites" class="mt-3">
                        <label class="form-label fw-bold">Selected Prerequisites:</label>
                        <div id="selectedPrerequisitesList" class="d-flex flex-wrap gap-2 mt-2">
                            <div class="text-muted">No prerequisites selected yet</div>
                        </div>
                    </div>

                    <select asp-for="SelectedPrerequisiteIds" multiple style="display: none;" id="selectedPrerequisiteIds">
                        <!-- Will be populated dynamically -->
                    </select>
                </div>
            </div>

            <div class="form-container">
                <h2 class="section-title"><i class="fas fa-image"></i> Course Thumbnail</h2>
                <input asp-for="Thumbnail" type="file" accept="image/*" class="form-control" />
            </div>

            <div class="form-container mt-4">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success btn-lg">
                        <i class="fas fa-rocket"></i> Create Course
                    </button>
                    <a href="/Courses/AllCourses" class="btn btn-secondary btn-lg">
                        <i class="fas fa-arrow-left"></i> Back to Courses
                    </a>
                </div>
            </div>
        </form>
    </div>

    <script src="~/js/CreateCourse.js"></script>
</body>
</html>