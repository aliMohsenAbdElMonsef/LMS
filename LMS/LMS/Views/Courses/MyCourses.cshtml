@{
    ViewData["Title"] = "My Courses";
}

<div class="container mt-4">
    <h2 class="mb-4">📚 My Courses</h2>
    <p class="empty-table">There is no courses for you right now</p>
    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Course Name</th>
                <th>Progress</th>
                <th>Lectures</th>
                <th>Start Date</th>
                <th>End Date</th>
                @if (User.IsInRole("Student"))
                {
                    <th>Cost</th>
                }
                <th>Enorlled At</th>
                @if (User.IsInRole("SubAdmin"))
                {
                    <th>Control Buttons</th>
                }
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><a asp-action="my-details" asp-controller="Courses" asp-route-id="1">.Net Web Developer (NET)</a></td>
                <td>50%</td>
                <td>34/68</td>
                <td>27/6/2025</td>
                <td>not set</td>
                @if (User.IsInRole("Student"))
                {
                    <th>0.00</th>
                }
                <td>24/6/2025 1pm</td>
                @if (User.IsInRole("SubAdmin"))
                {
                   <button class="subadmin-edit">Edit</button>
                }
            </tr>
        </tbody>
    </table>

</div>
