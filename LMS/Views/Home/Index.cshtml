@{
    ViewData["Title"] = "Home Page";
}
<div class="landing">
    <h1>Welcome to LMS</h1>
    <p>Learn anytime, anywhere. Access courses, join lectures, and earn certificates.</p>

    <div class="features">
        <h2>Why LMS?</h2>
        <ul>
            <li>📚 Access a variety of courses</li>
            <li>🎥 Join live online lectures</li>
            <li>📜 Earn certificates and track progress</li>
        </ul>
    </div>
    <div class="home-image">
        <img src="./images/Study Habits.jpeg" alt="Alternate Text" />
    </div>
    @if (!User.Identity.IsAuthenticated)
    {
        <div class="cta-buttons">
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Login</a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-secondary">Sign Up</a>
        </div>
    }
    else
    {
        <div class="cta-buttons">
            <a asp-controller="Account" asp-action="Logout" class="btn btn-secondary">Log out</a>
        </div>
    }
</div>