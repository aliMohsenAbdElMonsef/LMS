@model List<User>

@{
    ViewData["Title"] = "Create Course";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create New Course</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/createCourse.css" rel="stylesheet">
</head>
<body>
    <div class="floating-shapes">
        <div class="shape"></div>
        <div class="shape"></div>
        <div class="shape"></div>
    </div>

    <div class="main-container fade-in">
        <div class="header-section">
            <h1><i class="fas fa-graduation-cap"></i> Create New Course</h1>
        </div>

        <form method="post" action="/Courses/SavecreateCourse" enctype="multipart/form-data">

            <!-- Basic Information Section -->
            <div class="form-container">
                <h2 class="section-title">
                    <i class="fas fa-info-circle"></i>
                    Basic Information
                </h2>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label required">
                                <i class="fas fa-graduation-cap"></i>
                                Course Name
                            </label>
                            <input type="text" name="Name" class="form-control"
                                   placeholder="Enter course name" required />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label required">
                                <i class="fas fa-clock"></i>
                                Duration (Hours)
                            </label>
                            <input type="number" name="DurationHours" class="form-control"
                                   placeholder="Enter course Duration Hours"  required />
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label required">
                        <i class="fas fa-align-left"></i>
                        Course Description
                    </label>
                    <textarea class="form-control" name="Description" rows="4"
                              placeholder="Enter course  Description" required></textarea>
                </div>

                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-list-check"></i>
                        Prerequisites
                    </label>
                    <textarea class="form-control" name="Prerequisites" rows="3"
                              placeholder="Enter course Prerequisites"></textarea>
                </div>
            </div>

            <!-- Pricing Section -->
            <div class="form-container">
                <h2 class="section-title">
                    <i class="fas fa-dollar-sign"></i>
                    Pricing & Details
                </h2>

                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label required">
                                <i class="fas fa-money-bill"></i>
                                Course Price
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" name="Price" class="form-control" placeholder="0.00" required />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">
                                <i class="fas fa-user-tie"></i>
                                Instructor Name
                            </label>
                            <div class="instructor-select">
                                    <select id="InstructorName" name="InstructorId" class="form-select" >
                                    <option value="">-- instructor Name (optional) --</option>
                                        @foreach (var ins in Model){
                                                <option value="@ins.Id">@ins.FirstName @ins.LastName </option>
                                        }
                                    </select>
                                </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-container">
                <h3>Skills</h3>
                <div id="skills">
                    <div class="skill">
                        <label>Skill Name:</label>
                        <input type="text" name="Skills[0].Name"  />

                        <label>Duration (Hours):</label>
                        <input type="text" name="Skills[0].LecturesHours"  />

                        <button type="button" onclick="removeSkill(this)">Remove</button>
                    </div>
                </div>

                <button type="button" onclick="addSkill()">Add Skill</button>

            </div>

            <!-- Course Image Section -->
            <div class="form-container">
                <h2 class="section-title">
                    <i class="fas fa-image"></i>
                    Course Thumbnail
                </h2>

                <div class="mb-3">
                    <label class="form-label">Course Thumbnail</label>
                    <div class="upload-area" id="uploadArea" onclick="document.getElementById('photo').click()">
                        <input type="file" id="photo" name="photo" accept="image/*" style="display: none;" onchange="handleFileSelect(this)">

                        <!-- Default upload text -->
                        <div id="uploadText">
                            <i class="fas fa-cloud-upload-alt fs-1" style="color: #8B5CF6; "></i>
                            <p>Click to browse files (JPG, PNG, GIF - Max 5MB)</p>
                        </div>

                        <!-- Image preview (hidden initially) -->
                        <div id="imagePreview" style="display: none;">
                            <img id="previewImg" style="max-width: 200px; max-height: 200px; object-fit: cover; border-radius: 8px;" alt="Preview">
                            <p id="fileName" class="mt-2 text-success"></p>
                            <button type="button" class="btn btn-sm btn-outline-danger mt-2" onclick="removeImage()">Remove Image</button>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Action Buttons -->
            <div class="action-buttons">
                <a href="/Courses/AllCourses" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i>
                    Back to Courses
                </a>
                
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-rocket"></i>
                    Create Course
                </button>
            </div>
        </form>
    </div>

    <script>
        function handleFileSelect(input) {
            const file = input.files[0];
            const uploadText = document.getElementById('uploadText');
            const imagePreview = document.getElementById('imagePreview');
            const previewImg = document.getElementById('previewImg');
            const fileName = document.getElementById('fileName');

            if (file) {
                // Validate file type
                const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif'];
                if (!allowedTypes.includes(file.type)) {
                    alert('Please select a valid image file (JPEG, PNG, GIF)');
                    input.value = '';
                    return;
                }

                // Validate file size (5MB max)
                if (file.size > 5 * 1024 * 1024) {
                    alert('File size cannot exceed 5MB');
                    input.value = '';
                    return;
                }

                // Show image preview
                const reader = new FileReader();
                reader.onload = function(e) {
                    previewImg.src = e.target.result;
                    fileName.textContent = `Selected: ${file.name} (${(file.size / 1024 / 1024).toFixed(2)} MB)`;

                    // Hide upload text, show preview
                    uploadText.style.display = 'none';
                    imagePreview.style.display = 'block';
                };
                reader.readAsDataURL(file);
            }
        }

        function removeImage() {
            const input = document.getElementById('photo');
            const uploadText = document.getElementById('uploadText');
            const imagePreview = document.getElementById('imagePreview');

            // Clear file input
            input.value = '';

            // Show upload text, hide preview
            uploadText.style.display = 'block';
            imagePreview.style.display = 'none';
        }

        let index = 1;

           function addSkill() {
               const div = document.createElement('div');
               div.className = 'skill';
               div.innerHTML = `
                   <label>Skill Name:</label>
                   <input type="text" name="Skills[${index}].Name" required />

                   <label>Duration (Hours):</label>
                   <input type="text" name="Skills[${index}].LecturesHours"  required />

                   <button type="button" onclick="removeSkill(this)">Remove</button>
               `;
               document.getElementById('skills').appendChild(div);
               index++;
           }

           function removeSkill(btn) {
               if (document.querySelectorAll('.skill').length > 1) {
                   btn.parentElement.remove();
               } else {
                   alert('Must have at least one skill');
               }
           }    </script>
</body>
</html>