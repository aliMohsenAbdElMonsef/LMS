@{
    ViewData["Title"] = "All Courses";
}

<div class="container mt-4">
    <!-- Search Bar -->
    <div class="row mb-4">
        <div class="col-md-8 offset-md-2">
            <form method="get" action="#">
                <div class="input-group">
                    <input type="text" name="search" class="form-control" placeholder="Search courses..." />
                    <button type="submit" class="btn btn-primary">Search</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Course Card -->
    <div class="courses-container">
        <div class="card mb-4 shadow-sm" style="cursor: pointer;"
             onclick="location.href='@Url.Action("CourseDetails", "Courses", new { id = 1 })'">
            <img src="~/images/sample-course.jpg" class="card-img-top" alt="Course image" />
            <div class="card-body">
                <h5 class="card-title">Course Name</h5>
                <div class="rating">⭐ 4.5</div>
                <div class="course-joined">1,200 enrolled</div>
                <div class="total-hours">20h total</div>
            </div>
            <div class="card-footer d-flex justify-content-between align-items-center">
                <!-- View Details always visible -->
                <a asp-action="CourseDetails" asp-controller="Courses" asp-route-id="1" class="btn btn-link p-0">View Details</a>

                <!-- Role-based buttons -->
                @if (User.IsInRole("Instructor"))
                {
                    <button type="button" class="btn btn-success btn-sm">Apply</button>
                }
                @if (User.IsInRole("Student"))
                {
                    <button type="button" class="btn btn-success btn-sm">Enroll</button>
                }
                @if (User.IsInRole("Admin") || User.IsInRole("SubAdmin"))
                {
                    <button type="button" class="btn btn-warning btn-sm">Edit</button>
                }
                @if (User.IsInRole("Admin"))
                {
                    <button type="button" class="btn btn-danger btn-sm">Delete</button>
                }
            </div>
        </div>
    </div>
</div>
