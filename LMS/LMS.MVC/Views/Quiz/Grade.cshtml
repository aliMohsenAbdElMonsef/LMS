@model LMS.MVC.Models.ViewModels.Quiz.ManualGradeViewModel
@{
    ViewData["Title"] = "Grade Quiz";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 animate-fade-in-up">
        <div>
            <h2><i class="bi bi-check2-square"></i> Grade Quiz</h2>
            <p class="text-secondary mb-0">@Model.QuizTitle</p>
        </div>
        <a asp-action="Submissions" asp-route-id="@Model.QuizId" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Submissions
        </a>
    </div>

    <div class="card shadow-sm animate-fade-in-up">
        <div class="card-header bg-light">
            <h5 class="mb-0">Student Submission</h5>
        </div>
        <div class="card-body">
            <form asp-action="Grade" method="post">
                <input type="hidden" asp-for="QuizId" />
                <input type="hidden" asp-for="StudentId" />

                @for (int i = 0; i < Model.Questions.Count; i++)
                {
                    <div class="card mb-4 border-0 shadow-sm">
                        <div class="card-body">
                            <input type="hidden" asp-for="Questions[i].QuestionId" />
                            
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h5 class="card-title text-primary">Question @(i + 1)</h5>
                                <span class="badge bg-secondary">@Model.Questions[i].Points Points</span>
                            </div>
                            
                            <p class="lead mb-4">@Model.Questions[i].QuestionText</p>
                            
                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <div class="p-3 bg-light rounded h-100 border">
                                        <label class="form-label text-muted small fw-bold text-uppercase">Student Answer</label>
                                        <div class="fs-5">@Model.Questions[i].StudentAnswer</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="p-3 bg-success bg-opacity-10 rounded h-100 border border-success">
                                        <label class="form-label text-success small fw-bold text-uppercase">Correct Answer / Key</label>
                                        <div class="fs-5 text-success">@Model.Questions[i].CorrectAnswer</div>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex align-items-center p-3 bg-light rounded">
                                <div class="form-check form-switch form-check-lg mb-0">
                                    <input class="form-check-input" type="checkbox" asp-for="Questions[i].IsCorrect" id="q_@i">
                                    <label class="form-check-label fw-bold ms-2" for="q_@i">Mark as Correct</label>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-primary btn-lg px-5">
                        <i class="bi bi-save me-2"></i> Submit Grades
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .form-check-lg .form-check-input {
        width: 3em;
        height: 1.5em;
    }
</style>
