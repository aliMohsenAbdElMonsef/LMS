@model dynamic
@{
    ViewData["Title"] = "Edit Quiz";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card animate-fade-in-up">
                <div class="card-header">
                    <h4 class="mb-0"><i class="bi bi-pencil"></i> Edit Quiz</h4>
                </div>
                <div class="card-body">
                    <form method="post" asp-action="Edit">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="QuizId" value="@ViewBag.QuizId" />

                        <!-- Quiz Details -->
                        <div class="row g-3 mb-4">
                            <div class="col-12">
                                <label class="form-label">Quiz Title <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="Title" value="Module 1 Quiz" required>
                            </div>
                            
                            <div class="col-12">
                                <label class="form-label">Description</label>
                                <textarea class="form-control" name="Description" rows="3">Introduction to Web Development basics</textarea>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Duration (minutes) <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" name="DurationMinutes" value="30" min="1" required>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Passing Score (%) <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" name="PassingScore" value="70" min="0" max="100" required>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Max Attempts</label>
                                <input type="number" class="form-control" name="MaxAttempts" value="3" min="1">
                            </div>

                            <div class="col-12">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="IsActive" id="isActive" checked>
                                    <label class="form-check-label" for="isActive">
                                        Quiz is active and available to students
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Save Changes
                            </button>
                            <a href="@Url.Action("Index", "Quiz")" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                            <button type="button" class="btn btn-danger ms-auto" onclick="if(confirm('Are you sure you want to delete this quiz?')) { document.getElementById('deleteForm').submit(); }">
                                <i class="bi bi-trash"></i> Delete Quiz
                            </button>
                        </div>
                    </form>

                    <form id="deleteForm" method="post" asp-action="Delete" asp-route-id="@ViewBag.QuizId" class="d-none">
                        @Html.AntiForgeryToken()
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
