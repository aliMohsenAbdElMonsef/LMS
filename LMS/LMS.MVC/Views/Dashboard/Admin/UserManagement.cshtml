@using Domain.Enums
@model IEnumerable<LMS.MVC.Models.ViewModels.User.UserViewModel>
@{
    ViewData["Title"] = "User Management";
}

<h1 class="mb-4">User Management Dashboard</h1>

<div class="row g-2 mb-3">
    <div class="col-12 col-md-4">
        <input type="text" class="form-control" id="searchInput" placeholder="Search by email or name..." />
    </div>
    <div class="col-12 col-md-3">
        <select id="roleFilter" class="form-select">
            <option value="">All Roles</option>
            <option value="Admin">Admin</option>
            <option value="User">User</option>
            <option value="Instructor">Instructor</option>
        </select>
    </div>
    <div class="col-12 col-md-3">
        <select id="statusFilter" class="form-select">
            <option value="">All Status</option>
            <option value="Active">Approved</option>
            <option value="Pending">Pending</option>
            <option value="Suspended">Rejected</option>
        </select>
    </div>
    <div class="col-12 col-md-2">
        <button class="btn btn-primary w-100" id="filterBtn">Filter</button>
    </div>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th style="width:5%">Avatar</th>
            <th style="width:25%">Full Name</th>
            <th style="width:25%">Email</th>
            <th style="width:15%">Role</th>
            <th style="width:15%">Status</th>
            <th style="width:15%">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td><img src="@(user.UserImage ?? "~/images/default-avatar.png")" class="rounded-circle" width="40" /></td>
                <td class="text-truncate" style="max-width:150px;">@user.FirstName</td>
                <td class="text-truncate" style="max-width:150px;">@user.Email</td>
                <td>@user.ApplyAs</td>
                <td>
                    @switch (user.Status)
                    {
                        case ApplicationStatus.Approved:
                            <span class="badge bg-success">Active</span>
                            ; break;
                        case ApplicationStatus.Pending:
                            <span class="badge bg-warning">Pending</span>
                            ; break;
                        case ApplicationStatus.Rejected:
                            <span class="badge bg-danger">Suspended</span>
                            ; break;
                    }
                </td>
                <td>
                    <a class="btn btn-sm btn-primary" asp-action="Details" asp-route-id="@user.Id">View</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#filterBtn").click(function () {
                var search = $("#searchInput").val().toLowerCase();
                var role = $("#roleFilter").val();
                var status = $("#statusFilter").val();

                $("#usersTable tbody tr").each(function () {
                    var name = $(this).find("td:eq(1)").text().toLowerCase();
                    var username = $(this).find("td:eq(2)").text().toLowerCase();
                    var email = $(this).find("td:eq(3)").text().toLowerCase();
                    var rowRole = $(this).find("td:eq(4)").text();
                    var rowStatus = $(this).find("td:eq(5)").text();

                    var matchSearch = name.includes(search) || username.includes(search) || email.includes(search);
                    var matchRole = role === "" || role === rowRole;
                    var matchStatus = status === "" || status === rowStatus;

                    if (matchSearch && matchRole && matchStatus) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
            });
        });
    </script>
}
