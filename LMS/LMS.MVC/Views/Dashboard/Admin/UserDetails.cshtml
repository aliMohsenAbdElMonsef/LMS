@using Domain.Enums
@model LMS.MVC.Models.ViewModels.User.UserViewModel
@{
    ViewData["Title"] = "User Details";
}

<div class="container py-5">
    <div class="page-header mb-4 animate-fade-in-up">
        <div class="d-flex justify-content-between align-items-center">
            <h2><i class="bi bi-person-badge"></i> User Details</h2>
            <a asp-action="UserManagement" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm animate-fade-in-up">
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <img src="@(Model.UserImage ?? "/images/default-avatar.png")" 
                             alt="@Model.FirstName" 
                             class="rounded-circle img-thumbnail" 
                             style="width: 150px; height: 150px; object-fit: cover;">
                        <h3 class="mt-3">@Model.FirstName @Model.LastName</h3>
                        <p class="text-muted">@Model.Email</p>
                        <div>
                            @switch (Model.Status)
                            {
                                case ApplicationStatus.Approved:
                                    <span class="badge bg-success">Active</span>
                                    break;
                                case ApplicationStatus.Pending:
                                    <span class="badge bg-warning">Pending</span>
                                    break;
                                case ApplicationStatus.Rejected:
                                    <span class="badge bg-danger">Suspended</span>
                                    break;
                            }
                            <span class="badge bg-info ms-2">@Model.ApplyAs</span>
                        </div>
                    </div>

                    <hr />

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="text-muted small text-uppercase">User ID</label>
                            <p class="fw-bold">@Model.Id</p>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-muted small text-uppercase">Role</label>
                            <p class="fw-bold">@Model.ApplyAs</p>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-muted small text-uppercase">Account Status</label>
                            <p class="fw-bold">@Model.Status</p>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-muted small text-uppercase">Deleted</label>
                            <p class="fw-bold text-@(Model.IsDeleted ? "danger" : "success")">
                                @(Model.IsDeleted ? "Yes" : "No")
                            </p>
                        </div>
                        @if (Model.DeletedAt.HasValue)
                        {
                            <div class="col-sm-6">
                                <label class="text-muted small text-uppercase">Deleted At</label>
                                <p class="fw-bold">@Model.DeletedAt.Value.ToString("g")</p>
                            </div>
                        }
                    </div>

                    @if (Model.Status == ApplicationStatus.Pending)
                    {
                        <hr />
                        <div class="d-flex gap-2 justify-content-center mt-4">
                            <form asp-action="ApproveUser" asp-controller="Account" asp-route-id="@Model.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-check-circle"></i> Approve User
                                </button>
                            </form>
                            <form asp-action="DenyUser" asp-controller="Account" asp-route-id="@Model.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-x-circle"></i> Deny User
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
