@model LMS.MVC.Models.ViewModels.Enrollment.EnrollmentManagementVM

@{
    ViewData["Title"] = "Enrollment Management";
}

<div class="container mt-4">
    <h2 class="mb-4">Enrollment Management</h2>

    <form method="post" asp-action="CourseEnrollments" class="card p-3 mb-4">
        @Html.AntiForgeryToken()
        <div class="row">
            <div class="col-md-4">
                <label>Status</label>
                <select class="form-control" name="Request.SelectedStatus">
                    <option value="">All</option>
                    @if (Model.Request?.StatusList != null)
                    {
                        foreach (var status in Model.Request.StatusList)
                        {
                            <option value="@status.Value" selected="@(status.Value == Model.Request.SelectedStatus)">
                                @status.DisplayName
                            </option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label>Email / Username</label>
                <input type="text" class="form-control" name="Request.UserSearch"
                       value="@Model.Request.UserSearch"
                       placeholder="Search by user email or username" />
            </div>

            <div class="col-md-4">
                <label>Course (Name / Code)</label>
                <input type="text" class="form-control" name="Request.CourseSearch"
                       value="@Model.Request.CourseSearch"
                       placeholder="Search by course name or code" />
            </div>
        </div>

        <div class="mt-3 text-end">
            <button class="btn btn-primary" type="submit">
                <i class="bi bi-search"></i> Search
            </button>
            <a class="btn btn-secondary" asp-action="CourseEnrollments">
                Reset
            </a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-bordered table-hover text-center align-middle">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>User</th>
                    <th>Course</th>
                    <th>Status</th>
                    <th>Enrollment Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Enrollments != null && Model.Enrollments.Any())
                {
                    int count = 1;
                    foreach (var item in Model.Enrollments)
                    {
                        <tr>
                            <td>@count</td>
                            <td>@item.UserEmail (@item.UserName)</td>
                            <td>@item.CourseName (@item.CourseCode)</td>
                            <td>
                                <span class="badge
                                                    @(item.Status == "Pending" ? "bg-warning text-dark" :
                                                                                                                  item.Status == "Approved" ? "bg-success" :
                                                                                                                  item.Status == "Rejected" ? "bg-danger" : "bg-secondary")">
                            @item.Status
                        </span>
                    </td>
                    <td>@item.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td>
                        @if (item.Status == "Pending")
                                {
                                    <form method="post" asp-action="ApproveEnrollment">
                                        <input type="hidden" name="UserId" value="@item.UserId" />
                                        <input type="hidden" name="CourseId" value="@item.CourseId" />
                                        <button type="submit" class="btn btn-success btn-sm">Approve</button>
                                    </form>


                                    <form method="post" asp-action="RejectEnrollment">
                                        <input type="hidden" name="UserId" value="@item.UserId" />
                                        <input type="hidden" name="CourseId" value="@item.CourseId" />
                                        <button type="submit" class="btn btn-success btn-sm">Deny</button>
                                    </form>

                                }
                            </td>
                        </tr>
                        count++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-muted text-center p-3">
                            No enrollments found for the applied filters.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>