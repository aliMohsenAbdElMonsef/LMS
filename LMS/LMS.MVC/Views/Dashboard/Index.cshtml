@model dynamic
@{
    ViewData["Title"] = "My Dashboard";
    var role = User.IsInRole("Admin") ? "Admin" : User.IsInRole("Instructor") ? "Instructor" : "Student";
}

<div class="container-fluid py-4">

    <div class="row mb-4">
        <div class="col-12">
            <div class="page-header animate-fade-in-up">
                <h2><i class="bi bi-speedometer2"></i> @role Dashboard</h2>
                <p class="text-secondary">Welcome back, @User.Identity.Name!</p>
            </div>
        </div>
    </div>

    @if (User.IsInRole("Student"))
    {

        <div class="row g-4">

            <div class="col-md-3 animate-fade-in-up animate-delay-100">
                <div class="card stat-card bg-gradient-primary text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-white-50 mb-2">Enrolled Courses</h6>
                                <h2 class="mb-0">12</h2>
                            </div>
                            <div class="stat-icon">
                                <i class="bi bi-book"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3 animate-fade-in-up animate-delay-200">
                <div class="card stat-card bg-gradient-secondary text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-white-50 mb-2">Completed</h6>
                                <h2 class="mb-0">8</h2>
                            </div>
                            <div class="stat-icon">
                                <i class="bi bi-check-circle"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3 animate-fade-in-up animate-delay-300">
                <div class="card stat-card" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-white-50 mb-2">Certificates</h6>
                                <h2 class="mb-0">5</h2>
                            </div>
                            <div class="stat-icon">
                                <i class="bi bi-award"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3 animate-fade-in-up animate-delay-400">
                <div class="card stat-card" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: white;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-white-50 mb-2">Avg. Score</h6>
                                <h2 class="mb-0">85%</h2>
                            </div>
                            <div class="stat-icon">
                                <i class="bi bi-graph-up"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <div class="col-lg-8 animate-fade-in-up animate-delay-500">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-book"></i> My Courses</h5>
                    </div>
                    <div class="card-body">
                        <div class="list-group list-group-flush">
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-1">Web Development Bootcamp</h6>
                                    <small class="text-muted">Progress: 75%</small>
                                    <div class="progress mt-2" style="height: 6px;">
                                        <div class="progress-bar bg-gradient-primary" style="width: 75%"></div>
                                    </div>
                                </div>
                                <a href="#" class="btn btn-sm btn-primary">Continue</a>
                            </div>
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-1">Python for Data Science</h6>
                                    <small class="text-muted">Progress: 45%</small>
                                    <div class="progress mt-2" style="height: 6px;">
                                        <div class="progress-bar bg-gradient-primary" style="width: 45%"></div>
                                    </div>
                                </div>
                                <a href="#" class="btn btn-sm btn-primary">Continue</a>
                            </div>
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-1">UI/UX Design Masterclass</h6>
                                    <small class="text-muted">Progress: 90%</small>
                                    <div class="progress mt-2" style="height: 6px;">
                                        <div class="progress-bar bg-gradient-primary" style="width: 90%"></div>
                                    </div>
                                </div>
                                <a href="#" class="btn btn-sm btn-primary">Continue</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <div class="col-lg-4 animate-fade-in-up animate-delay-600">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-calendar-check"></i> Upcoming</h5>
                    </div>
                    <div class="card-body">
                        <div class="list-group list-group-flush">
                            <div class="list-group-item px-0">
                                <div class="d-flex justify-content-between">
                                    <small class="text-danger"><i class="bi bi-clock"></i> Due in 2 days</small>
                                </div>
                                <h6 class="mb-1 mt-2">Assignment 3</h6>
                                <small class="text-muted">Web Development</small>
                            </div>
                            <div class="list-group-item px-0">
                                <div class="d-flex justify-content-between">
                                    <small class="text-warning"><i class="bi bi-clock"></i> Due in 5 days</small>
                                </div>
                                <h6 class="mb-1 mt-2">Quiz 2</h6>
                                <small class="text-muted">Python Course</small>
                            </div>
                            <div class="list-group-item px-0">
                                <div class="d-flex justify-content-between">
                                    <small class="text-success"><i class="bi bi-clock"></i> Due in 1 week</small>
                                </div>
                                <h6 class="mb-1 mt-2">Final Project</h6>
                                <small class="text-muted">UI/UX Design</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (User.IsInRole("Instructor"))
    {

        <div class="row g-4">
            <div class="col-md-3 animate-fade-in-up">
                <div class="card stat-card bg-gradient-primary text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-white-50 mb-2">My Courses</h6>
                                <h2 class="mb-0">8</h2>
                            </div>
                            <div class="stat-icon">
                                <i class="bi bi-book"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3 animate-fade-in-up animate-delay-100">
                <div class="card stat-card bg-gradient-secondary text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-white-50 mb-2">Total Students</h6>
                                <h2 class="mb-0">245</h2>
                            </div>
                            <div class="stat-icon">
                                <i class="bi bi-people"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3 animate-fade-in-up animate-delay-200">
                <div class="card stat-card" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: white;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-white-50 mb-2">Pending Reviews</h6>
                                <h2 class="mb-0">12</h2>
                            </div>
                            <div class="stat-icon">
                                <i class="bi bi-clipboard-check"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3 animate-fade-in-up animate-delay-300">
                <div class="card stat-card" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-white-50 mb-2">Avg. Rating</h6>
                                <h2 class="mb-0">4.8</h2>
                            </div>
                            <div class="stat-icon">
                                <i class="bi bi-star"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <div class="col-12 animate-fade-in-up animate-delay-400">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-lightning"></i> Quick Actions</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <a href="@Url.Action("Create", "Course")" class="btn btn-primary w-100">
                                    <i class="bi bi-plus-circle"></i> Create Course
                                </a>
                            </div>
                            <div class="col-md-3">
                                <a href="@Url.Action("Create", "Quiz")" class="btn btn-secondary w-100">
                                    <i class="bi bi-file-earmark-text"></i> Create Quiz
                                </a>
                            </div>
                            <div class="col-md-3">
                                <a href="@Url.Action("Create", "Assignment")" class="btn btn-success w-100">
                                    <i class="bi bi-clipboard-plus"></i> Create Assignment
                                </a>
                            </div>
                            <div class="col-md-3">
                                <a href="@Url.Action("Submissions", "Assignment")" class="btn btn-warning w-100">
                                    <i class="bi bi-eye"></i> View Submissions
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {

        <div class="row g-4">
            <div class="col-md-3 animate-fade-in-up">
                <div class="card stat-card bg-gradient-primary text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-white-50 mb-2">Total Users</h6>
                                <h2 class="mb-0">1,234</h2>
                            </div>
                            <div class="stat-icon">
                                <i class="bi bi-people"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3 animate-fade-in-up animate-delay-100">
                <div class="card stat-card bg-gradient-secondary text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-white-50 mb-2">Total Courses</h6>
                                <h2 class="mb-0">156</h2>
                            </div>
                            <div class="stat-icon">
                                <i class="bi bi-book"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3 animate-fade-in-up animate-delay-200">
                <div class="card stat-card" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: white;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-white-50 mb-2">Pending Approvals</h6>
                                <h2 class="mb-0">23</h2>
                            </div>
                            <div class="stat-icon">
                                <i class="bi bi-hourglass-split"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3 animate-fade-in-up animate-delay-300">
                <div class="card stat-card" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-white-50 mb-2">Active Enrollments</h6>
                                <h2 class="mb-0">3,456</h2>
                            </div>
                            <div class="stat-icon">
                                <i class="bi bi-graph-up"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <div class="col-12 animate-fade-in-up animate-delay-400">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-gear"></i> Admin Panel</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <a href="@Url.Action("UserManagement", "Dashboard")" class="btn btn-primary w-100">
                                    <i class="bi bi-people"></i> Manage Users
                                </a>
                            </div>
                            <div class="col-md-3">
                                <a href="@Url.Action("Index", "Course")" class="btn btn-secondary w-100">
                                    <i class="bi bi-book"></i> Manage Courses
                                </a>
                            </div>
                            <div class="col-md-3">
                                <a href="@Url.Action("CategoryManagement", "Dashboard")" class="btn btn-success w-100">
                                    <i class="bi bi-tags"></i> Manage Categories
                                </a>
                            </div>
                            <div class="col-md-3">
                                <a href="@Url.Action("CourseEnrollments", "Dashboard")" class="btn btn-warning w-100">
                                    <i class="bi bi-clipboard-check"></i> Enrollments
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
.stat-card {
    border: none;
    border-radius: 1rem;
    transition: all 0.3s ease;
}

.stat-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
}

.stat-icon {
    font-size: 2.5rem;
    opacity: 0.3;
}

.progress {
    border-radius: 1rem;
}

.list-group-item {
    border: none;
    border-bottom: 1px solid #e5e7eb;
}

.list-group-item:last-child {
    border-bottom: none;
}
</style>
