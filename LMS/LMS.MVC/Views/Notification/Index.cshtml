@model dynamic
@{
    ViewData["Title"] = "Notifications";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <!-- Page Header -->
            <div class="d-flex justify-content-between align-items-center mb-4 animate-fade-in-up">
                <div>
                    <h2><i class="bi bi-bell"></i> Notifications</h2>
                    <p class="text-secondary mb-0">Stay updated with your latest activities</p>
                </div>
                <form method="post" asp-action="MarkAllAsRead">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-check-all"></i> Mark All as Read
                    </button>
                </form>
            </div>

            <!-- Notifications List -->
            <div class="notifications-list">
                <!-- Unread Notification -->
                <div class="notification-item unread animate-fade-in-up">
                    <div class="notification-icon bg-primary">
                        <i class="bi bi-book"></i>
                    </div>
                    <div class="notification-content">
                        <h6 class="notification-title">New Course Available</h6>
                        <p class="notification-text">A new course "Advanced JavaScript" has been added to your recommended list.</p>
                        <small class="notification-time text-muted">
                            <i class="bi bi-clock"></i> 5 minutes ago
                        </small>
                    </div>
                    <div class="notification-actions">
                        <form method="post" asp-action="MarkAsRead" asp-route-id="1" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-link">
                                <i class="bi bi-check"></i>
                            </button>
                        </form>
                        <form method="post" asp-action="Delete" asp-route-id="1" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-link text-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Read Notification -->
                <div class="notification-item animate-fade-in-up animate-delay-100">
                    <div class="notification-icon bg-success">
                        <i class="bi bi-check-circle"></i>
                    </div>
                    <div class="notification-content">
                        <h6 class="notification-title">Assignment Graded</h6>
                        <p class="notification-text">Your assignment "Web Development Project" has been graded. Score: 95/100</p>
                        <small class="notification-time text-muted">
                            <i class="bi bi-clock"></i> 2 hours ago
                        </small>
                    </div>
                    <div class="notification-actions">
                        <form method="post" asp-action="Delete" asp-route-id="2" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-link text-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Unread Notification -->
                <div class="notification-item unread animate-fade-in-up animate-delay-200">
                    <div class="notification-icon bg-warning">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>
                    <div class="notification-content">
                        <h6 class="notification-title">Assignment Due Soon</h6>
                        <p class="notification-text">Your assignment "Python Data Analysis" is due in 2 days.</p>
                        <small class="notification-time text-muted">
                            <i class="bi bi-clock"></i> 1 day ago
                        </small>
                    </div>
                    <div class="notification-actions">
                        <form method="post" asp-action="MarkAsRead" asp-route-id="3" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-link">
                                <i class="bi bi-check"></i>
                            </button>
                        </form>
                        <form method="post" asp-action="Delete" asp-route-id="3" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-link text-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Read Notification -->
                <div class="notification-item animate-fade-in-up animate-delay-300">
                    <div class="notification-icon bg-info">
                        <i class="bi bi-trophy"></i>
                    </div>
                    <div class="notification-content">
                        <h6 class="notification-title">Certificate Earned</h6>
                        <p class="notification-text">Congratulations! You've earned a certificate for completing "UI/UX Design Masterclass".</p>
                        <small class="notification-time text-muted">
                            <i class="bi bi-clock"></i> 3 days ago
                        </small>
                    </div>
                    <div class="notification-actions">
                        <form method="post" asp-action="Delete" asp-route-id="4" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-link text-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Empty State (if no notifications) -->
                @* Uncomment if no notifications
                <div class="card text-center py-5">
                    <div class="card-body">
                        <i class="bi bi-bell-slash" style="font-size: 5rem; color: #d1d5db;"></i>
                        <h4 class="mt-3">No Notifications</h4>
                        <p class="text-muted">You're all caught up!</p>
                    </div>
                </div>
                *@
            </div>
        </div>
    </div>
</div>

<style>
.notifications-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.notification-item {
    display: flex;
    align-items: start;
    gap: 1rem;
    padding: 1.5rem;
    background: white;
    border-radius: 1rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    transition: all 0.3s ease;
}

.notification-item:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    transform: translateX(5px);
}

.notification-item.unread {
    background: linear-gradient(135deg, #f9fafb 0%, #ffffff 100%);
    border-left: 4px solid #667eea;
}

.notification-icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1.25rem;
    flex-shrink: 0;
}

.notification-content {
    flex: 1;
}

.notification-title {
    margin-bottom: 0.5rem;
    font-weight: 600;
    color: #1f2937;
}

.notification-text {
    margin-bottom: 0.5rem;
    color: #6b7280;
    font-size: 0.9rem;
}

.notification-time {
    font-size: 0.8rem;
}

.notification-actions {
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
}

.notification-actions .btn-link {
    padding: 0.25rem 0.5rem;
    text-decoration: none;
}
</style>
