@model dynamic
@{
    ViewData["Title"] = "Certificate";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">

            <div class="card certificate-preview animate-fade-in-up">
                <div class="card-body p-5 text-center">
                    <div class="certificate-border">
                        <div class="certificate-content">
                            <div class="certificate-logo mb-4">
                                <i class="bi bi-mortarboard-fill" style="font-size: 4rem; color: #667eea;"></i>
                            </div>
                            
                            <h1 class="certificate-title mb-3">Certificate of Completion</h1>
                            
                            <p class="certificate-subtitle mb-4">This is to certify that</p>
                            
                            <h2 class="student-name mb-4">John Doe</h2>
                            
                            <p class="certificate-text mb-4">
                                has successfully completed the course
                            </p>
                            
                            <h3 class="course-name mb-4">Web Development Bootcamp</h3>
                            
                            <div class="certificate-details row justify-content-center mb-4">
                                <div class="col-md-4">
                                    <p class="mb-1"><strong>Completion Date</strong></p>
                                    <p>January 15, 2024</p>
                                </div>
                                <div class="col-md-4">
                                    <p class="mb-1"><strong>Score</strong></p>
                                    <p>95%</p>
                                </div>
                                <div class="col-md-4">
                                    <p class="mb-1"><strong>Grade</strong></p>
                                    <p>A+</p>
                                </div>
                            </div>
                            
                            <div class="certificate-footer mt-5">
                                <div class="row">
                                    <div class="col-6">
                                        <div class="signature-line"></div>
                                        <p class="mb-0"><strong>Instructor Signature</strong></p>
                                        <p class="text-muted small">Dr. Jane Smith</p>
                                    </div>
                                    <div class="col-6">
                                        <div class="signature-line"></div>
                                        <p class="mb-0"><strong>Director Signature</strong></p>
                                        <p class="text-muted small">LMS Platform</p>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="certificate-id mt-4">
                                <small class="text-muted">Certificate ID: CERT-2024-001234</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <div class="text-center mt-4">
                <a href="@Url.Action("Download", "Certificate", new { id = ViewBag.CertificateId })" class="btn btn-success btn-lg me-2">
                    <i class="bi bi-download"></i> Download PDF
                </a>
                <a href="@Url.Action("Index", "Certificate")" class="btn btn-outline-secondary btn-lg">
                    <i class="bi bi-arrow-left"></i> Back to Certificates
                </a>
            </div>
        </div>
    </div>
</div>

<style>
.certificate-preview {
    border: none;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
}

.certificate-border {
    border: 8px double #667eea;
    padding: 2rem;
    background: linear-gradient(135deg, #f9fafb 0%, #ffffff 100%);
}

.certificate-content {
    border: 2px solid #e5e7eb;
    padding: 3rem;
}

.certificate-title {
    font-family: 'Poppins', sans-serif;
    font-size: 2.5rem;
    font-weight: 700;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.student-name {
    font-family: 'Poppins', sans-serif;
    font-size: 2rem;
    color: #1f2937;
    border-bottom: 2px solid #667eea;
    display: inline-block;
    padding-bottom: 0.5rem;
}

.course-name {
    font-family: 'Poppins', sans-serif;
    font-size: 1.75rem;
    color: #667eea;
}

.signature-line {
    width: 200px;
    height: 2px;
    background: #1f2937;
    margin: 0 auto 0.5rem;
}

.certificate-id {
    padding-top: 1rem;
    border-top: 1px solid #e5e7eb;
}

@@media print {
    .btn, .page-header {
        display: none;
    }
}
</style>
