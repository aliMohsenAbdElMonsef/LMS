@model LMS.MVC.Models.ViewModels.Home.HomeViewModel
@{
    ViewData["Title"] = "Home - Learn & Grow";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <div class="hero-content">
                    <h1 class="hero-title">Unlock Your Potential with Expert-Led Courses</h1>
                    <p class="hero-description">Join thousands of learners mastering new skills. Access world-class courses, earn certificates, and advance your career.</p>
                    <div class="hero-actions">
                        <a href="/Account/Register" class="btn btn-primary btn-lg me-3">Get Started Free</a>
                        <a href="/Account/Login" class="btn btn-outline-secondary btn-lg">Sign In</a>
                    </div>
                    <div class="hero-stats mt-4">
                        <div class="stat-item">
                            <span class="stat-number">@Model.TotalStudents+</span>
                            <span class="stat-label">Students</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-number">@Model.TotalCourses+</span>
                            <span class="stat-label">Courses</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-number">@Model.TotalInstructors+</span>
                            <span class="stat-label">Expert Instructors</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="hero-image">
                    <img src="~/images/hero-learning.svg" alt="Online Learning" class="img-fluid" />
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Categories Section -->
<section class="categories-section py-5">
    <div class="container">
        <div class="section-header text-center mb-5">
            <h2 class="section-title">Explore Top Categories</h2>
            <p class="section-subtitle">Discover courses across various domains</p>
        </div>
        <div class="row g-4">
            @foreach (var category in Model.Categories)
            {
                <div class="col-md-4 col-sm-6">
                    <div class="category-card" onclick="redirectToLogin()">
                        <div class="category-icon">
                            <i class="fas fa-folder"></i> <!-- Default icon, consider adding Icon property to Category -->
                        </div>
                        <h3 class="category-title">@category.Name</h3>
                        <p class="category-count">@category.CoursesCount Courses</p>
                        <div class="category-overlay">
                            <span class="lock-icon"><i class="fas fa-lock"></i></span>
                            <p class="overlay-text">Sign in to access</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Popular Courses Section -->
<section class="courses-section py-5 bg-light-purple">
    <div class="container">
        <div class="section-header text-center mb-5">
            <h2 class="section-title">Popular Courses</h2>
            <p class="section-subtitle">Start learning with our most popular courses</p>
        </div>
        <div class="row g-4">
            @foreach (var course in Model.PopularCourses)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="course-card card h-100" onclick="redirectToLogin()">
                        <img src="@(string.IsNullOrEmpty(course.ThumbnailPath) ? "/images/default-course.jpg" : course.ThumbnailPath)" class="card-img-top course-thumbnail" alt="@course.Name">
                        @if (course.IsFree)
                        {
                            <div class="course-badge badge-free-course">Free</div>
                        }
                        else
                        {
                            <div class="course-badge">Bestseller</div>
                        }
                        <div class="card-body">
                            <h5 class="card-title">@course.Name</h5>
                            <p class="course-description">@course.Description</p>
                            <div class="course-meta mb-3">
                                <span class="me-3"><i class="fas fa-user"></i> @course.AdminName</span> <!-- Assuming AdminName is Instructor Name -->
                                <span><i class="fas fa-star text-warning"></i> @course.AverageRating.ToString("0.0") (@course.EnrolledStudentsCount)</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                @if (course.IsFree)
                                {
                                    <span class="badge badge-free">Free</span>
                                }
                                else
                                {
                                    <span class="badge badge-price">$@course.Price</span>
                                }
                                <span class="badge badge-language">@course.Language</span>
                            </div>
                        </div>
                        <div class="card-overlay">
                            <span class="lock-icon-large"><i class="fas fa-lock"></i></span>
                            <p class="overlay-text-large">Sign in to enroll</p>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="text-center mt-5">
            <a href="/Account/Register" class="btn btn-primary btn-lg">Sign Up to View All Courses</a>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="features-section py-5">
    <div class="container">
        <div class="section-header text-center mb-5">
            <h2 class="section-title">Why Choose Our Platform?</h2>
            <p class="section-subtitle">Everything you need to succeed in your learning journey</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-card text-center">
                    <div class="feature-icon">
                        <i class="fas fa-graduation-cap"></i>
                    </div>
                    <h4 class="feature-title">Expert Instructors</h4>
                    <p class="feature-description">Learn from industry professionals with years of real-world experience.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card text-center">
                    <div class="feature-icon">
                        <i class="fas fa-certificate"></i>
                    </div>
                    <h4 class="feature-title">Certified Courses</h4>
                    <p class="feature-description">Earn recognized certificates upon course completion to boost your career.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card text-center">
                    <div class="feature-icon">
                        <i class="fas fa-infinity"></i>
                    </div>
                    <h4 class="feature-title">Lifetime Access</h4>
                    <p class="feature-description">Access your courses anytime, anywhere, on any device - forever.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card text-center">
                    <div class="feature-icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <h4 class="feature-title">Community Support</h4>
                    <p class="feature-description">Join a vibrant community of learners and get help when you need it.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card text-center">
                    <div class="feature-icon">
                        <i class="fas fa-clock"></i>
                    </div>
                    <h4 class="feature-title">Learn at Your Pace</h4>
                    <p class="feature-description">Self-paced learning that fits your schedule and learning style.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card text-center">
                    <div class="feature-icon">
                        <i class="fas fa-medal"></i>
                    </div>
                    <h4 class="feature-title">Quality Content</h4>
                    <p class="feature-description">High-quality video lessons, quizzes, and hands-on projects.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="cta-section py-5">
    <div class="container">
        <div class="cta-content text-center">
            <h2 class="cta-title">Ready to Start Learning?</h2>
            <p class="cta-description">Join our community today and take the first step towards achieving your goals.</p>
            <a href="/Account/Register" class="btn btn-primary btn-lg">Create Your Free Account</a>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function redirectToLogin() {
            window.location.href = '/Account/Login';
        }
    </script>
}