@{
    ViewData["Title"] = "Home Page";
    Layout = "_Layout"; 
}


<!-- Hero Section -->
<section class="hero bg-primary text-white py-5">
    <div class="container text-center">
        <h1 class="display-3 fw-bold">Learn Anytime, Anywhere</h1>
        <p class="lead mb-4">Join learners and explore our wide range of courses.</p>
        <a href="/Courses" class="btn btn-light btn-lg me-2">Browse Courses</a>
        <a href="/Account/SignUp" class="btn btn-outline-light btn-lg">Get Started</a>
    </div>
</section>

<!-- Featured Courses Section -->
<section class="featured-courses py-5">
    <div class="container">
        <h2 class="mb-4 text-center">Popular Courses</h2>
        <div class="row row-cols-1 row-cols-md-3 g-4">
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <img src="/images/course1.jpg" class="card-img-top" alt="Course 1">
                    <div class="card-body">
                        <h5 class="card-title">Web Development</h5>
                        <p class="card-text">Learn HTML, CSS, JavaScript, and ASP.NET Core from scratch.</p>
                    </div>
                    <div class="card-footer">
                        <small class="text-muted">⭐ 4.8 | Beginner</small>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <img src="/images/course2.jpg" class="card-img-top" alt="Course 2">
                    <div class="card-body">
                        <h5 class="card-title">Data Science</h5>
                        <p class="card-text">Master Python, SQL, and Machine Learning techniques.</p>
                    </div>
                    <div class="card-footer">
                        <small class="text-muted">⭐ 4.7 | Intermediate</small>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <img src="/images/course3.jpg" class="card-img-top" alt="Course 3">
                    <div class="card-body">
                        <h5 class="card-title">Graphic Design</h5>
                        <p class="card-text">Learn Photoshop, Illustrator, and design principles creatively.</p>
                    </div>
                    <div class="card-footer">
                        <small class="text-muted">⭐ 4.9 | All Levels</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Why Choose Us Section -->
<section class="why-us py-5 bg-light">
    <div class="container">
        <h2 class="text-center mb-5">Why Choose Our LMS?</h2>
        <div class="row text-center">
            <div class="col-md-3 mb-4">
                <i class="bi bi-people-fill display-4 text-primary"></i>
                <h5 class="mt-3">Expert Instructors</h5>
                <p>Learn from experienced professionals and industry experts.</p>
            </div>
            <div class="col-md-3 mb-4">
                <i class="bi bi-clock-fill display-4 text-primary"></i>
                <h5 class="mt-3">Flexible Learning</h5>
                <p>Access courses anytime, anywhere, on any device.</p>
            </div>
            <div class="col-md-3 mb-4">
                <i class="bi bi-award-fill display-4 text-primary"></i>
                <h5 class="mt-3">Certificates</h5>
                <p>Earn certificates to showcase your achievements.</p>
            </div>
            <div class="col-md-3 mb-4">
                <i class="bi bi-chat-left-text-fill display-4 text-primary"></i>
                <h5 class="mt-3">Community Support</h5>
                <p>Engage with a community of learners for guidance and motivation.</p>
            </div>
        </div>
    </div>
</section>

<!-- Testimonials Section -->
<section class="testimonials py-5">
    <div class="container">
        <h2 class="text-center mb-5">What Our Students Say</h2>
        <div class="row row-cols-1 row-cols-md-3 g-4">
            <div class="col">
                <div class="card shadow-sm p-3">
                    <p>"The courses are well-structured and easy to follow. Highly recommended!"</p>
                    <div class="d-flex align-items-center mt-3">
                        <img src="/images/student1.jpg" alt="Student 1" class="rounded-circle me-2" width="50">
                        <div>
                            <strong>Sarah M.</strong><br>
                            <small>Web Development Student</small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card shadow-sm p-3">
                    <p>"I could learn at my own pace and get help whenever needed. Excellent platform."</p>
                    <div class="d-flex align-items-center mt-3">
                        <img src="/images/student2.jpg" alt="Student 2" class="rounded-circle me-2" width="50">
                        <div>
                            <strong>Ahmed K.</strong><br>
                            <small>Data Science Student</small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card shadow-sm p-3">
                    <p>"The instructors are amazing, and the community support is incredible."</p>
                    <div class="d-flex align-items-center mt-3">
                        <img src="/images/student3.jpg" alt="Student 3" class="rounded-circle me-2" width="50">
                        <div>
                            <strong>Layla S.</strong><br>
                            <small>Design Student</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Call to Action Section -->
<section class="cta bg-primary text-white py-5">
    <div class="container text-center">
        <h2 class="mb-4">Ready to Start Learning?</h2>
        <a href="/Account/SignUp" class="btn btn-light btn-lg">Sign Up Now</a>
    </div>
</section>
