@model LMS.MVC.Models.ViewModels.Assignment.AssignmentDetailsResult
@{
    ViewData["Title"] = "Assignment Details";
    var isInstructor = User.IsInRole("Instructor");
    var isStudent = User.IsInRole("Student");
    var isAdmin = User.IsInRole("Admin");
    var canEditDelete = isInstructor && Model.DueDate > DateTime.Now;
    var studentSubmission = Model.StudentSubmissions.FirstOrDefault(s => s.StudentId == ViewBag.CurrentStudentId);
    var canSubmit = isStudent && Model.DueDate > DateTime.Now && (studentSubmission == null || !studentSubmission.Grade.HasValue);
    var canResubmit = isStudent && Model.DueDate > DateTime.Now && studentSubmission != null && !studentSubmission.Grade.HasValue;
}

<div class="row">

    <div class="col-md-8">
        <h2>@Model.Title</h2>
        
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
            TempData.Remove("SuccessMessage");
        }

        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Assignment Information</h5>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Course:</strong> @Model.CourseName
                    </div>
                    <div class="col-md-6">
                        <strong>Instructor:</strong> @Model.InstructorName
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Upload Date:</strong> @Model.UploadDate.ToString("MMM dd, yyyy")
                    </div>
                    <div class="col-md-6">
                        <strong>Due Date:</strong>
                        <span class="@(Model.DueDate < DateTime.Now ? "text-danger" : "text-success")">
                            @Model.DueDate.ToString("MMM dd, yyyy hh:mm tt")
                        </span>
                        @if (Model.DueDate < DateTime.Now)
                        {
                            <span class="badge bg-danger ms-1">Expired</span>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="mb-3">
                        <strong>Description:</strong>
                        <p class="mt-2">@Model.Description</p>
                    </div>
                }

                <div class="mb-3">
                    <strong>Assignment File:</strong>
                    <div class="mt-2">
                        <a href="@Model.FilePath" class="btn btn-outline-primary btn-sm" target="_blank">
                            <i class="fas fa-download"></i> Download Assignment
                        </a>
                    </div>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <!-- Instructor/Admin Actions -->
                    @if (isInstructor || isAdmin)
                    {
                        @if (canEditDelete || isAdmin)
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                        }

                        <a asp-action="Submissions" asp-route-id="@Model.Id" class="btn btn-info">
                            <i class="fas fa-list"></i> View Submissions (@Model.SubmissionsCount)
                        </a>

                    }

                    <!-- Student Actions -->
                    @if (isStudent)
                    {
                        @if (canSubmit)
                        {
                            <a asp-action="Submit" asp-route-id="@Model.Id" class="btn btn-primary">
                                <i class="fas fa-paper-plane"></i> Submit Assignment
                            </a>
                        }
                        else if (canResubmit)
                        {
                            <a asp-action="Submit" asp-route-id="@Model.Id" class="btn btn-warning">
                                <i class="fas fa-redo"></i> Resubmit Assignment
                            </a>
                        }
                    }

                    <a asp-controller="Course" asp-action="Details" asp-route-id="@Model.CourseId" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Back to Course
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Submission Statistics</h5>
            </div>
            <div class="card-body">
                <!-- Overall Statistics -->
                <div class="text-center mb-4">
                    <h3 class="text-primary">@Model.SubmissionsCount</h3>
                    <p class="text-muted">Total Submissions</p>

                   
                </div>

                <!-- Student Personal Status -->
                @if (isStudent)
                {
                    <hr>
                    <h6>Your Submission</h6>

                    if (studentSubmission != null)
                    {
                        <div class="mt-2">
                            <strong>Status:</strong>
                            <span class="badge @GetStatusBadgeClass(studentSubmission.Status)">@studentSubmission.Status</span>
                        </div>

                        if (studentSubmission.Grade.HasValue)
                        {
                            <div class="mt-2">
                                <strong>Grade:</strong>
                                <span class="fw-bold text-success">@studentSubmission.Grade.Value/100</span>
                            </div>
                        }

                        <div class="mt-2">
                            <strong>Submitted:</strong>
                            <span>@studentSubmission.SubmittedAt.ToString("MMM dd, yyyy hh:mm tt")</span>
                        </div>

                        @if (!string.IsNullOrEmpty(studentSubmission.FilePath))
                        {
                            <div class="mt-2">
                                <a href="@studentSubmission.FilePath" class="btn btn-outline-primary btn-sm" target="_blank">
                                    <i class="fas fa-download"></i> Your Submission
                                </a>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="mt-2">
                            <span class="badge bg-warning">Not Submitted</span>
                        </div>
                        <small class="text-muted">Due: @Model.DueDate.ToString("MMM dd, yyyy hh:mm tt")</small>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
@if ((isInstructor || isAdmin) && (canEditDelete || isAdmin))
{
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                   
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to delete the assignment "@Model.Title"?
                    @if (Model.SubmissionsCount > 0)
                    {
                        <div class="alert alert-warning mt-2">
                            <i class="fas fa-exclamation-triangle"></i>
                            This assignment has @Model.SubmissionsCount submission(s). Deleting it will also remove all submissions.
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">Delete Assignment</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@functions {
    public string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Graded" => "bg-success",
            "Submitted" => "bg-primary",
            "Pending Grading" => "bg-warning",
            "Not Submitted" => "bg-secondary",
            _ => "bg-secondary"
        };
    }
}