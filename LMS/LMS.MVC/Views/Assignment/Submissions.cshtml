@model IEnumerable<LMS.MVC.Models.ViewModels.Assignment.StudentAssignmentResult>
@{
    ViewData["Title"] = "Assignment Submissions";
    var assignmentId = ViewBag.AssignmentId;
    var status = ViewBag.Status as string;
}
<h2 class="mb-4">Assignment Submissions</h2>

<!-- Status Filter Buttons -->
<div class="card mb-4">
    <div class="card-header">
        <h5 class="card-title mb-0">Filter by Status</h5>
    </div>
    <div class="card-body">
        <div class="btn-group" role="group">
            <a asp-action="Submissions" asp-route-id="@assignmentId"
               class="btn @(string.IsNullOrEmpty(status) ? "btn-primary" : "btn-outline-primary")">
                All Submissions
            </a>
            <a asp-action="SubmissionsByStatus" asp-route-id="@assignmentId" asp-route-status="PendingGrading"
               class="btn @(status == "PendingGrading" ? "btn-warning" : "btn-outline-warning")">
                Pending Grading
            </a>
            <a asp-action="SubmissionsByStatus" asp-route-id="@assignmentId" asp-route-status="Graded"
               class="btn @(status == "Graded" ? "btn-success" : "btn-outline-success")">
                Graded
            </a>
            <a asp-action="SubmissionsByStatus" asp-route-id="@assignmentId" asp-route-status="NotSubmitted"
               class="btn @(status == "NotSubmitted" ? "btn-secondary" : "btn-outline-secondary")">
                Not Submitted
            </a>
        </div>

        @if (!string.IsNullOrEmpty(status))
        {
            <div class="mt-2">
                <span class="badge bg-info">Filtered by: @status</span>
            </div>
        }
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">Student Submissions</h5>
        <span class="badge bg-primary">@Model.Count() Submissions</span>
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="text-center py-4">
                <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                <p class="text-muted">No submissions found.</p>
                <a asp-action="Submissions" asp-route-id="@assignmentId" class="btn btn-outline-primary">Show All Submissions</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Student Name</th>
                            <th>Submission Date</th>
                            <th>Status</th>
                            <th>Grade</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var submission in Model)
                        {
                            <tr>
                                <td>@submission.StudentName</td>
                                <td>
                                    @if (submission.IsSubmitted)
                                    {
                                        @submission.SubmittedAt.ToString("MMM dd, yyyy hh:mm tt")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @GetStatusBadgeClass(submission.Status)">@submission.Status</span>
                                </td>
                                <td>
                                    @if (submission.Grade.HasValue)
                                    {
                                        <span class="fw-bold @(submission.Grade.Value >= 50 ? "text-success" : "text-danger")">
                                            @submission.Grade.Value/100
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                
                                <td>
                                    <div class="d-flex gap-2">
                                        @if (submission.IsSubmitted)
                                        {
                                            <a asp-action="DownloadSubmission"
                                               asp-route-studentAssignmentId="@submission.Id"
                                               class="btn btn-sm btn-primary border "
                                               title="Download Submission">
                                                <i class="fas fa-download">Download Submission</i>
                                            </a>
                                        }
                                        <a asp-action="Grade"
                                           asp-route-id="@submission.Id"
                                           class="btn btn-sm btn-primary border "
                                           title="Grade Assignment">
                                            <i class="fas fa-edit">Grade Assignment</i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-action="Details" asp-route-id="@assignmentId" class="btn btn-secondary">Back to Assignment</a>
</div>

@functions {
    public string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Graded" => "bg-success",
            "Pending Grading" => "bg-warning",
            "Not Submitted" => "bg-secondary",
            _ => "bg-secondary"
        };
    }
}
