@model LMS.MVC.Models.ViewModels.Assignment.StudentAssignmentResult
@{
    ViewData["Title"] = "Submit Assignment";
    var isResubmission = !string.IsNullOrEmpty(Model.Id) && Model.Id != Guid.Empty.ToString();
}

<h2 class="mb-4">Submit Assignment</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
    @TempData.Remove("SuccessMessage")
}

@Html.ValidationSummary(true, "", new { @class = "text-danger" })

<form asp-action="Submit" method="post" class="needs-validation" novalidate enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="AssignmentId" />
    <input type="hidden" asp-for="StudentId" />

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="card-title mb-0">Assignment Submission</h5>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrEmpty(Model.FilePath))
            {
                <div class="alert alert-info">
                    <strong>Current Submission:</strong>
                    <a asp-action="DownloadSubmission"
                       asp-route-studentAssignmentId="@Model.Id"
                       class="ms-2">View Current File</a>
                </div>
            }

            <div class="mb-3">
                <label for="submissionFile" class="form-label">Upload Your Solution</label>
                <input type="file" class="form-control" id="submissionFile" name="submissionFile"
                       accept=".pdf,.doc,.docx,.txt,.zip,.rar" required />
                <small class="form-text text-muted">Allowed formats: PDF, Word, Text, ZIP, RAR files (Max: 10MB)</small>
                <span asp-validation-for="FilePath" class="text-danger"></span>
            </div>

            @if (isResubmission)
            {
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle"></i>
                    <strong>Note:</strong> Submitting a new file will replace your current submission.
                </div>
            }

        </div>
    </div>

    <button type="submit" class="btn btn-success">
        <i class="fas fa-paper-plane"></i> Submit Assignment
    </button>
    <a asp-action="Details" asp-route-id="@Model.AssignmentId" class="btn btn-secondary ms-2">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // File size validation
        document.getElementById('submissionFile').addEventListener('change', function(e) {
            var file = e.target.files[0];
            if (file && file.size > 10 * 1024 * 1024) { // 10MB
                alert('File size must be less than 10MB');
                e.target.value = '';
            }
        });
    </script>
}