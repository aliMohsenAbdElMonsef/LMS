@model LMS.MVC.Models.ViewModels.Assignment.MyAssignmentsViewModel
@{
    ViewData["Title"] = "My Assignments";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="fas fa-tasks me-2"></i>My Assignments
        </h2>
    </div>

    <!-- Filter Buttons -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="card-title mb-0">Filter Assignments</h5>
        </div>
        <div class="card-body">
            <div class="btn-group" role="group">
                <a asp-action="MyAssignments" asp-route-filter="all"
                   class="btn @(ViewBag.Filter == "all" || string.IsNullOrEmpty(ViewBag.Filter) ? "btn-primary" : "btn-outline-primary")">
                    <i class="fas fa-list me-1"></i> All
                </a>
                <a asp-action="MyAssignments" asp-route-filter="notsubmitted"
                   class="btn @(ViewBag.Filter == "notsubmitted" ? "btn-warning" : "btn-outline-warning")">
                    <i class="fas fa-times-circle me-1"></i> Not Submitted
                </a>
                <a asp-action="MyAssignments" asp-route-filter="pending"
                   class="btn @(ViewBag.Filter == "pending" ? "btn-secondary" : "btn-outline-secondary")">
                    <i class="fas fa-clock me-1"></i> Pending Grading
                </a>
                <a asp-action="MyAssignments" asp-route-filter="graded"
                   class="btn @(ViewBag.Filter == "graded" ? "btn-success" : "btn-outline-success")">
                    <i class="fas fa-check-circle me-1"></i> Graded
                </a>
                <a asp-action="MyAssignments" asp-route-filter="overdue"
                   class="btn @(ViewBag.Filter == "overdue" ? "btn-danger" : "btn-outline-danger")">
                    <i class="fas fa-exclamation-triangle me-1"></i> Overdue
                </a>
            </div>
        </div>
    </div>

    <!-- Assignments List -->
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="card-title mb-0">
                <i class="fas fa-list me-2"></i>
                @if (ViewBag.Filter == "notsubmitted")
                {
                    <text>Not Submitted Assignments</text>
                }
                else if (ViewBag.Filter == "pending")
                {
                    <text>Pending Grading Assignments</text>
                }
                else if (ViewBag.Filter == "graded")
                {
                    <text>Graded Assignments</text>
                }
                else if (ViewBag.Filter == "overdue")
                {
                    <text>Overdue Assignments</text>
                }
                else
                {
                    <text>All Assignments</text>
                }
            </h5>
        </div>
        <div class="card-body">
            @if (!Model.Assignments.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-inbox fa-4x text-muted mb-3"></i>
                    <h4 class="text-muted">No Assignments Found</h4>
                    <p class="text-muted">
                        @if (ViewBag.Filter == "notsubmitted")
                        {
                            <text>You don't have any assignments to submit.</text>
                        }
                        else if (ViewBag.Filter == "pending")
                        {
                            <text>You don't have any assignments pending grading.</text>
                        }
                        else if (ViewBag.Filter == "graded")
                        {
                            <text>You don't have any graded assignments yet.</text>
                        }
                        else if (ViewBag.Filter == "overdue")
                        {
                            <text>You don't have any overdue assignments.</text>
                        }
                        else
                        {
                            <text>You don't have any assignments.</text>
                        }
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Course</th>
                                <th>Assignment</th>
                                <th>Due Date</th>
                                <th>Status</th>
                                <th>Grade</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var assignment in Model.Assignments)
                            {
                                var isOverdue = assignment.DueDate < DateTime.Now && !assignment.IsSubmitted;
                                var isUrgent = assignment.DueDate < DateTime.Now.AddDays(2) && assignment.DueDate > DateTime.Now && !assignment.IsSubmitted;
                                var canResubmit = assignment.IsSubmitted && !assignment.Grade.HasValue && assignment.DueDate > DateTime.Now;

                                <tr class="@(isOverdue ? "table-danger" : isUrgent ? "table-warning" : "")">
                                    <td>
                                        <strong>@assignment.CourseName</strong>
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@assignment.AssignmentId"
                                           class="text-decoration-none fw-bold">
                                            @assignment.AssignmentTitle
                                        </a>
                                        @if (isOverdue)
                                        {
                                            <span class="badge bg-danger ms-2">
                                                <i class="fas fa-exclamation-circle"></i> OVERDUE
                                            </span>
                                        }
                                        else if (isUrgent)
                                        {
                                            <span class="badge bg-warning text-dark ms-2">
                                                <i class="fas fa-exclamation-triangle"></i> URGENT
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <small class="@(isOverdue ? "text-danger fw-bold" : "text-muted")">
                                            <i class="fas fa-calendar-alt me-1"></i>
                                            @assignment.DueDate.ToString("MMM dd, yyyy hh:mm tt")
                                        </small>
                                    </td>
                                    <td>
                                        @if (assignment.IsSubmitted)
                                        {
                                            <span class="badge @GetStatusBadgeClass(assignment.Status)">
                                                @assignment.StatusDisplay
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Not Submitted
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (assignment.Grade.HasValue)
                                        {
                                            <span class="fw-bold @(assignment.Grade.Value >= 50 ? "text-success" : "text-danger")">
                                                @assignment.Grade.Value/100
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-1">
                                           

                                            @* Submit Button - Show if not submitted and not overdue *@
                                            @if (!assignment.IsSubmitted && assignment.DueDate > DateTime.Now)
                                            {
                                                <a asp-action="Submit" asp-route-id="@assignment.AssignmentId"
                                                   class="btn btn-sm btn-primary"
                                                   title="Submit Assignment">
                                                    <i class="fas fa-paper-plane me-1"></i> Submit
                                                </a>
                                            }

                                            @* Resubmit Button - Show if submitted but not graded and not overdue *@
                                            @if (canResubmit)
                                            {
                                                <a asp-action="Submit" asp-route-id="@assignment.AssignmentId"
                                                   class="btn btn-sm btn-primary"
                                                   title="Resubmit Assignment">
                                                    <i class="fas fa-redo me-1"></i> Resubmit
                                                </a>
                                            }

                                            
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@functions {
    public string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Graded" => "bg-success",
            "Pending Grading" => "bg-secondary",
            "Not Submitted" => "bg-warning text-dark",
            _ => "bg-secondary"
        };
    }
}