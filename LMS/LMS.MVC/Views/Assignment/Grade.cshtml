@model LMS.MVC.Models.ViewModels.Assignment.StudentAssignmentResult
@{
    ViewData["Title"] = "Grade Assignment";
}

<h2 class="mb-4">Grade Assignment</h2>

@Html.ValidationSummary(true, "", new { @class = "text-danger" })

<form asp-action="Grade" method="post" class="needs-validation" novalidate>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="AssignmentId" />
    <input type="hidden" asp-for="StudentId" />
    <input type="hidden" asp-for="StudentName" />

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="card-title mb-0">Student Submission</h5>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Student:</strong> @Model.StudentName
                </div>
                <div class="col-md-6">
                    <strong>Submitted:</strong> @Model.SubmittedAt.ToString("MMM dd, yyyy hh:mm tt")
                </div>
            </div>

            <div class="mb-3">
                <strong>Submission File:</strong>
                <div class="mt-2">
                    <a href="@Model.FilePath" class="btn btn-outline-primary btn-sm" target="_blank">
                        <i class="fas fa-download"></i> Download Submission
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="card-title mb-0">Grading</h5>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label asp-for="Grade" class="form-label">Grade (0-100)</label>
                <input asp-for="Grade" type="number" class="form-control" min="0" max="100" step="0.1" required />
                <span asp-validation-for="Grade" class="text-danger"></span>
                <small class="form-text text-muted">Enter a grade between 0 and 100</small>
            </div>

            <div class="mb-3">
                <label asp-for="Feedback" class="form-label">Feedback (Optional)</label>
                <textarea asp-for="Feedback" class="form-control" rows="3"
                          placeholder="Enter feedback for the student..."></textarea>
                <span asp-validation-for="Feedback" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-success">
            <i class="fas fa-check"></i> Submit Grade
        </button>
        <a asp-action="Submissions" asp-route-id="@Model.AssignmentId" class="btn btn-secondary ms-2">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}