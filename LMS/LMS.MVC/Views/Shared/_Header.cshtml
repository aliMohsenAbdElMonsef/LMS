@{
    // Remove @page directive from partial views
}
<header class="site-header">
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                <i class="bi bi-mortarboard-fill"></i> LMS Platform
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Home")">
                            <i class="bi bi-house-door"></i> Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Course")">
                            <i class="bi bi-book"></i> Courses
                        </a>
                    </li>
                   
                   
                    <!-- Authentication Section -->
                    @if (User.Identity.IsAuthenticated)
                    {
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("CategoryManagement", "Dashboard")">
                                    <i class="bi bi-tags"></i> Categories
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Dashboard" asp-action="UserManagement">
                                    <i class="bi bi-people"></i> User Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Dashboard" asp-action="CourseEnrollments">
                                    <i class="bi bi-people"></i> Enrollment Dashboard
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Student") || User.IsInRole("Instructor"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Course" asp-action="MyCourses">
                                    <i class="bi bi-mortarboard"></i> My Courses
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Lecture" asp-action="MyLectures">
                                    <i class="bi bi-collection-play"></i> My Lectures
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Instructor"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Assignment" && ViewContext.RouteData.Values["Action"]?.ToString() == "InstructorAssignments" ? "active": "")" 
                                   asp-controller="Assignment" asp-action="InstructorAssignments">
                                    <i class="bi bi-clipboard-check me-1"></i> My Assignments
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Quiz" && ViewContext.RouteData.Values["Action"]?.ToString() == "InstructorQuizzes" ? "active" : "")" 
                                   asp-controller="Quiz" asp-action="InstructorQuizzes">
                                    <i class="bi bi-question-circle me-1"></i> My Quizzes
                                </a>
                            </li>
                        }
                        
                        @if (User.IsInRole("Student"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Assignment" && ViewContext.RouteData.Values["Action"]?.ToString() == "MyAssignments" ? "active" : "")" 
                                   asp-controller="Assignment" asp-action="MyAssignments">
                                    <i class="bi bi-clipboard-check me-1"></i> My Assignments
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Quiz" && ViewContext.RouteData.Values["Action"]?.ToString() == "MyQuizzes" ? "active" : "")" 
                                   asp-controller="Quiz" asp-action="MyQuizzes">
                                    <i class="bi bi-question-circle me-1"></i> My Quizzes
                                </a>
                            </li>
                        }
                        
                        <!-- User Profile Dropdown -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" 
                               data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle"></i> @User.Identity.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                <li>
                                    <a class="dropdown-item" asp-controller="Profile" asp-action="Index">
                                        <i class="bi bi-person"></i> My Profile
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Profile" asp-action="Edit">
                                        <i class="bi bi-pencil-square"></i> Edit Profile
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form method="post" asp-controller="Account" asp-action="Logout">
                                        <button type="submit" class="dropdown-item">
                                            <i class="bi bi-box-arrow-right"></i> Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right"></i> Login
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="SignUp">
                                <i class="bi bi-person-plus"></i> Sign Up
                            </a>
                        </li>
                    }
                    
                    <!-- Dark Mode Toggle -->
                    <li class="nav-item d-flex align-items-center mx-2">
                        <div class="theme-toggle" id="themeToggle" title="Toggle Dark Mode">
                            <div class="theme-toggle-slider">
                                <i class="fas fa-sun"></i>
                            </div>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>