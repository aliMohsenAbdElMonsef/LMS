@model LMS.MVC.Models.ViewModels.Lecture.LectureViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            @if (!string.IsNullOrEmpty(Model.RecordingPath))
            {
                <div class="card">
                    <div class="card-body p-0">
                        <video id="lectureVideo" class="w-100" controls>
                            <source src="@Url.Action("StreamRecording", "Lecture", new { id = Model.Id })" type="video/mp4">
                            Your browser does not support the video tag.
                        </video>
                    </div>
                </div>
            }
            else
            {
                <div class="card">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-camera-video-off fs-1 text-muted d-block mb-3"></i>
                        <h4 class="text-muted">No Recording Available</h4>
                        <p class="text-muted mb-0">This lecture has not been recorded yet.</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
