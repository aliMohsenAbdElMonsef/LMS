@model LMS.MVC.Models.ViewModels.Lecture.CreateLectureViewModel
@{
    ViewData["Title"] = "Add Lecture";
    var courseId = ViewBag.CourseId;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card animate-fade-in-up">
                <div class="card-header">
                    <h4 class="mb-0"><i class="bi bi-plus-circle"></i> Add New Lecture</h4>
                </div>
                <div class="card-body">
                    <form method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="CourseId" value="@courseId" />

                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">Lecture Title <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" asp-for="Title" placeholder="e.g., Introduction to HTML" required>
                            </div>

                            <div class="col-12">
                                <label class="form-label">Description</label>
                                <textarea class="form-control" asp-for="Description" rows="4" placeholder="Describe what students will learn..."></textarea>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Lecture Date <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" asp-for="LectureDate" required>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Start Time <span class="text-danger">*</span></label>
                                <input type="time" class="form-control" asp-for="StartTime" required>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Assigned Instructor <span class="text-danger">*</span></label>
                                <select class="form-select" asp-for="InstructorId" required>
                                    <option value="">-- Select Instructor --</option>
                                    @if (ViewBag.Instructors != null)
                                    {
                                        foreach (var instructor in ViewBag.Instructors)
                                        {
                                            <option value="@instructor.Id">@instructor.Name</option>
                                        }
                                    }
                                </select>
                            </div>



                            <div class="col-md-6">
                                <label class="form-label">Duration (minutes)</label>
                                <input type="number" class="form-control" asp-for="DurationMinutes" placeholder="45">
                            </div>

                            <div class="col-12">
                                <label class="form-label">Video File</label>
                                <input type="file" class="form-control" name="VideoFile" accept="video/*">
                                <small class="text-muted">Supported formats: MP4, WebM, AVI (Max: 500MB)</small>
                            </div>

                            <div class="col-12">
                                <label class="form-label">Video URL (Alternative)</label>
                                <input type="url" class="form-control" asp-for="VideoUrl" placeholder="https://youtube.com/watch?v=...">
                                <small class="text-muted">Or provide a YouTube/Vimeo link instead of uploading</small>
                            </div>

                            <div class="col-12">
                                <label class="form-label">Attachments/Resources</label>
                                <input type="file" class="form-control" name="Resources" multiple>
                                <small class="text-muted">PDF, DOC, ZIP files (Optional)</small>
                            </div>

                            <div class="col-12">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="IsPreview" id="isPreview">
                                    <label class="form-check-label" for="isPreview">
                                        Allow as free preview (visible to non-enrolled students)
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Add Lecture
                            </button>
                            <a href="@Url.Action("Index", "Lecture", new { courseId })" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
