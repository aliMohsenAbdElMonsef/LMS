@model LMS.MVC.Models.ViewModels.CertificateTemplate.CertificateTemplateViewModel

@{
    ViewData["Title"] = "Template Details";
}

<div class="container mt-5">
    <h2>Template Details</h2>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Title</dt>
        <dd class="col-sm-10">@Model.Title</dd>
        
        <dt class="col-sm-2">Course</dt>
        <dd class="col-sm-10">@Model.CourseName</dd>
        
        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Description</dd>
        
        <dt class="col-sm-2">Message Body</dt>
        <dd class="col-sm-10">@Model.MessageBody</dd>
        
        <dt class="col-sm-2">Created At</dt>
        <dd class="col-sm-10">@Model.CreatedAt</dd>
    </dl>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>
