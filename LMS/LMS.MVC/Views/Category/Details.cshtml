@model LMS.MVC.Models.ViewModels.Category.CategoryDetailsResult

@{
    ViewData["Title"] = "Category Details";
}
<div class="container mt-4">
    <h2 class="text-primary">@Model.Name</h2>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">ID</dt>
        <dd class="col-sm-9">@Model.Id</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@(Model.Description ?? "No description")</dd>

        <dt class="col-sm-3">Created On</dt>
        <dd class="col-sm-9">@Model.CreationDate.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-3">Last Updated</dt>
        <dd class="col-sm-9">@(Model.LastUpdated?.ToString("yyyy-MM-dd") ?? "Never")</dd>

        <dt class="col-sm-3">Total Courses</dt>
        <dd class="col-sm-9">@Model.CoursesCount</dd>
    </dl>

    <h4 class="mt-4">Courses in this category</h4>

    @if (Model.Courses.Any())
    {
        <div class="row">
            @foreach (var course in Model.Courses)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        @if (!string.IsNullOrEmpty(course.ThumbnailPath))
                        {
                            <img src="@course.ThumbnailPath" class="card-img-top" alt="@course.Name" style="height:180px; object-fit:cover;">
                        }
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@course.Name</h5>
                            <p class="card-text text-truncate">@course.Description</p>
                            <p class="mb-1"><strong>Credits:</strong> @course.Credits</p>
                            <p class="mb-1"><strong>Level:</strong> @course.Level</p>
                            <p class="mb-1"><strong>Language:</strong> @course.Language</p>
                            <p class="mb-1"><strong>Price:</strong> @(course.IsFree ? "Free" : course.Price.ToString("C"))</p>
                            <div class="mt-auto">
                                <a asp-controller="Course" asp-action="Details" asp-route-id="@course.Id" class="btn btn-sm btn-primary w-100">View Details</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p>No courses in this category.</p>
    }

    <div class="mt-3">
        <a asp-action="CategoryManagement" asp-controller="Dashboard" class="btn btn-secondary">Back to Categories</a>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Edit" asp-controller="Category" asp-route-id="@Model.Id" class="btn btn-primary">Edit Category</a>   
        }
    </div>
</div>
