@using Domain.Enums
@using LMS.MVC.Models.ViewModels.Course
@model EditCourseViewModel

@{
    ViewData["Title"] = "Edit Course";
}

<style>
    .category-badge {
        background-color: var(--primary-color);
        color: #fff !important;
        border-radius: 0.5rem;
        font-size: 0.95rem;
        font-weight: 500;
    }

        .category-badge .btn-close-white {
            filter: brightness(0) invert(1);
        }
</style>

<div class="page-header">
    <h2><i class="bi bi-pencil-square"></i> Edit Course</h2>
</div>

<div class="form-container">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form asp-action="Edit" asp-controller="Course" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="AdminId" />

        <div class="row g-3">

            <!-- Course Name -->
            <div class="col-md-6">
                <label asp-for="Name" class="form-label"><i class="bi bi-card-heading"></i> Course Name</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <!-- Course Code -->
            <div class="col-md-6">
                <label asp-for="CourseCode" class="form-label"><i class="bi bi-hash"></i> Course Code</label>
                <input asp-for="CourseCode" class="form-control" />
                <span asp-validation-for="CourseCode" class="text-danger"></span>
            </div>

            <!-- Description -->
            <div class="col-md-12">
                <label asp-for="Description" class="form-label"><i class="bi bi-file-text"></i> Description</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <!-- Category -->
            <div class="col-md-12">
                <label class="form-label"><i class="bi bi-tags"></i> Category</label>

                <input type="text" id="categorySearch" class="form-control mb-2"
                       placeholder="Search or type to change category..."
                       autocomplete="off"
                       style="@(string.IsNullOrEmpty(Model.CategoryId) ? "" : "display:none;")" />

                <ul id="categorySuggestions" class="list-group position-absolute w-50 shadow-sm"
                    style="z-index: 1000; display: none;"></ul>

                <div id="selectedCategories" class="mt-3 d-flex flex-wrap gap-2">
                    @if (!string.IsNullOrEmpty(Model.CategoryId))
                    {
                        <span class="badge category-badge p-2 d-flex align-items-center gap-1">
                            @(Model.CategoryName ?? "Unknown Category")
                            <button type="button" class="btn-close btn-close-white ms-2 remove-category"></button>
                        </span>
                    }
                </div>

                <div id="hiddenCategoryInputs">
                    @if (!string.IsNullOrEmpty(Model.CategoryId))
                    {
                        <input type="hidden" name="CategoryId" value="@Model.CategoryId" />
                    }
                </div>

                <small class="text-muted">
                    Can't find a category?
                    <a asp-controller="Category" asp-action="Create" target="_blank">Create a new one</a>
                </small>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <!-- Level -->
            <div class="col-md-6">
                <label asp-for="Level" class="form-label"><i class="bi bi-bar-chart-line"></i> Level</label>
                <select asp-for="Level" class="form-select"
                        asp-items="Html.GetEnumSelectList<Level>()"></select>
                <span asp-validation-for="Level" class="text-danger"></span>
            </div>

            <!-- Language -->
            <div class="col-md-6">
                <label asp-for="Language" class="form-label"><i class="bi bi-translate"></i> Language</label>
                <input asp-for="Language" class="form-control" />
                <span asp-validation-for="Language" class="text-danger"></span>
            </div>

            <!-- Credits -->
            <div class="col-md-6">
                <label asp-for="Credits" class="form-label"><i class="bi bi-award"></i> Credits</label>
                <input asp-for="Credits" type="number" class="form-control" min="0" />
                <span asp-validation-for="Credits" class="text-danger"></span>
            </div>

            <!-- Start Date -->
            <div class="col-md-6">
                <label asp-for="StartDate" class="form-label"><i class="bi bi-calendar-event"></i> Start Date</label>
                <input asp-for="StartDate" type="date" class="form-control" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>

            <!-- End Date -->
            <div class="col-md-6">
                <label asp-for="EndDate" class="form-label"><i class="bi bi-calendar-check"></i> End Date</label>
                <input asp-for="EndDate" type="date" class="form-control" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>

            <!-- Price -->
            <div class="col-md-6">
                <label asp-for="Price" class="form-label"><i class="bi bi-currency-dollar"></i> Price</label>
                <input asp-for="Price" type="number" step="0.01" class="form-control" min="0" id="priceInput" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <!-- Delivery Mode -->
            <div class="col-md-6">
                <label asp-for="DeliveryMode" class="form-label"><i class="bi bi-laptop"></i> Delivery Mode</label>
                <select asp-for="DeliveryMode" class="form-select">
                    <option value="">-- Select Delivery Mode --</option>
                    @foreach (var mode in Enum.GetValues(typeof(DeliveryMode)).Cast<DeliveryMode>())
                    {
                        <option value="@mode">@mode</option>
                    }
                </select>
                <span asp-validation-for="DeliveryMode" class="text-danger"></span>
            </div>

            <!-- Thumbnail -->
            <div class="col-md-12">
                <label asp-for="ThumbnailFile" class="form-label"><i class="bi bi-image"></i> Thumbnail</label>

                @if (!string.IsNullOrEmpty(Model.ThumbnailPath))
                {
                    <div class="mb-2">
                        <img src="@Model.ThumbnailPath" class="img-thumbnail" style="max-height: 140px;" alt="Course thumbnail" />
                    </div>
                }

                <input asp-for="ThumbnailFile" type="file" class="form-control" accept="image/*" />
                <span asp-validation-for="ThumbnailFile" class="text-danger"></span>
            </div>

            <!-- Min Attendance -->
            <div class="col-md-6">
                <label asp-for="MinAttendancePercentage" class="form-label"><i class="bi bi-check2-square"></i> Min Attendance %</label>
                <input asp-for="MinAttendancePercentage" type="number" step="0.1" class="form-control" min="0" max="100" />
                <span asp-validation-for="MinAttendancePercentage" class="text-danger"></span>
            </div>

            <!-- Min Performance Score -->
            <div class="col-md-6">
                <label asp-for="MinPerformanceScore" class="form-label"><i class="bi bi-stars"></i> Min Performance Score</label>
                <input asp-for="MinPerformanceScore" type="number" step="0.1" class="form-control" min="0" max="100" />
                <span asp-validation-for="MinPerformanceScore" class="text-danger"></span>
            </div>

            <!-- Is Free -->
            <div class="col-md-4">
                <div class="form-check mt-4">
                    <input asp-for="IsFree" class="form-check-input" type="checkbox" id="isFreeCheckbox" />
                    <label asp-for="IsFree" class="form-check-label"><i class="bi bi-gift"></i> Free Course</label>
                </div>
            </div>

            <!-- ✅ Every Student Could Enroll -->
            <div class="col-md-4">
                <div class="form-check mt-4">
                    <input asp-for="EveryStuCouldEnroll" class="form-check-input" type="checkbox" />
                    <label asp-for="EveryStuCouldEnroll" class="form-check-label">
                        <i class="bi bi-people"></i> Every Student Can Enroll
                    </label>
                </div>
            </div>

            <!-- Auto Certificates -->
            <div class="col-md-4">
                <div class="form-check mt-4">
                    <input asp-for="AutoIssueCertificates" class="form-check-input" type="checkbox" />
                    <label asp-for="AutoIssueCertificates" class="form-check-label">
                        <i class="bi bi-patch-check"></i> Auto-issue Certificates
                    </label>
                </div>
            </div>

            <!-- Certificate Template -->
            <div class="col-md-12">
                <label asp-for="CertificateTemplateId" class="form-label"><i class="bi bi-award"></i> Certificate Template</label>
                <input asp-for="CertificateTemplateId" class="form-control" />
                <span asp-validation-for="CertificateTemplateId" class="text-danger"></span>
            </div>

            <!-- Actions -->
            <div class="col-md-12 mt-4">
                <div class="d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-circle"></i> Cancel</a>
                    <button type="submit" class="btn btn-success"><i class="bi bi-save"></i> Save Changes</button>
                </div>
            </div>

        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Price toggle functionality
            const isFreeCheckbox = document.getElementById('isFreeCheckbox');
            const priceInput = document.getElementById('priceInput');

            function updatePriceField() {
                if (isFreeCheckbox && priceInput) {
                    priceInput.disabled = isFreeCheckbox.checked;
                    if (isFreeCheckbox.checked) {
                        priceInput.value = "0";
                    }
                }
            }
            updatePriceField();
            if (isFreeCheckbox) {
                isFreeCheckbox.addEventListener('change', updatePriceField);
            }

            // Category search
            const categories = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AvailableCategories ?? new List<LMS.MVC.Models.ViewModels.Course.CategoryOption>()));
            const searchBox = document.getElementById('categorySearch');
            const suggestionsList = document.getElementById('categorySuggestions');
            const selectedContainer = document.getElementById('selectedCategories');
            const hiddenInputs = document.getElementById('hiddenCategoryInputs');

            function resetCategory() {
                selectedContainer.innerHTML = '';
                hiddenInputs.innerHTML = '';
                searchBox.style.display = 'block';
                searchBox.value = '';
            }

            function updateSuggestions() {
                const query = searchBox.value.trim().toLowerCase();
                suggestionsList.innerHTML = '';

                if (!query) {
                    suggestionsList.style.display = 'none';
                    return;
                }

                const matches = categories
                    .filter(c => c && c.Name && c.Name.toLowerCase().includes(query))
                    .slice(0, 5);

                suggestionsList.style.display = matches.length ? 'block' : 'none';

                matches.forEach(c => {
                    const li = document.createElement('li');
                    li.className = 'list-group-item list-group-item-action';
                    li.textContent = c.Name;
                    li.dataset.id = c.Id;
                    li.onclick = () => selectCategory(c);
                    suggestionsList.appendChild(li);
                });
            }

            function selectCategory(c) {
                if (!c || !c.Id || !c.Name) return;

                selectedContainer.innerHTML = `
                    <span class="badge category-badge p-2 d-flex align-items-center gap-1">
                        ${c.Name}
                        <button type="button" class="btn-close btn-close-white ms-2 remove-category"></button>
                    </span>
                `;

                hiddenInputs.innerHTML = `<input type="hidden" name="CategoryId" value="${c.Id}" />`;

                document.querySelector('.remove-category').onclick = resetCategory;

                searchBox.value = '';
                searchBox.style.display = 'none';
                suggestionsList.style.display = 'none';
            }

            if (searchBox) {
                searchBox.oninput = updateSuggestions;
            }

            document.addEventListener('click', e => {
                if (searchBox && suggestionsList &&
                    !searchBox.contains(e.target) && !suggestionsList.contains(e.target)) {
                    suggestionsList.style.display = 'none';
                }
            });

            document.querySelectorAll('.remove-category').forEach(btn => {
                btn.addEventListener('click', resetCategory);
            });
        });
    </script>
}
