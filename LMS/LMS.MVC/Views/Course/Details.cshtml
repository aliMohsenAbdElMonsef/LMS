@using Domain.Enums
@using LMS.MVC.Models.ViewModels.Course
@model ReadCourseViewModel

@{
    ViewData["Title"] = "Course Details";
}

<div class="page-header mb-4">
    <h2><i class="bi bi-book"></i> @Model.Name</h2>
</div>

<div class="row g-4">

    <div class="col-md-4">
        @if (!string.IsNullOrEmpty(Model.ThumbnailPath))
        {
            <div class="card mb-4 shadow-sm">
                <img src="@Model.ThumbnailPath" class="card-img-top" alt="Course Thumbnail" />
            </div>
        }

        <div class="card mb-4 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Course Stats</h5>
                <p class="card-text"><strong>Enrolled Students:</strong> @Model.EnrolledStudentsCount</p>
                <p class="card-text"><strong>Average Rating:</strong> @Model.AverageRating</p>
                <p class="card-text"><strong>Total Sessions:</strong> @Model.TotalSessions</p>
                <p class="card-text"><strong>Hours/Session:</strong> @Model.HoursPerSession</p>
                <p class="card-text"><strong>Days/Week:</strong> @Model.DaysPerWeek</p>
                <p class="card-text"><strong>Last Updated:</strong> @(Model.LastUpdate?.ToString("yyyy-MM-dd HH:mm") ?? "-")</p>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Course Information</h5>
                <p><strong>Course Code:</strong> @Model.CourseCode</p>
                <p><strong>Description:</strong> @Model.Description</p>
                <p><strong>Category:</strong> @Model.CategoryName</p>
                <p><strong>Level:</strong> @Model.Level</p>
                <p><strong>Language:</strong> @Model.Language</p>
                <p><strong>Credits:</strong> @Model.Credits</p>
                <p><strong>Delivery Mode:</strong> @Model.DeliveryMode</p>
                <p><strong>Status:</strong> @Model.Status</p>
                <p>
                    <strong>Start Date:</strong> @Model.StartDate |
                    <strong>End Date:</strong> @Model.EndDate |
                    <strong>Duration:</strong> @Model.DurationWeeks weeks
                </p>
                <p><strong>Price:</strong> @(Model.IsFree ? "Free" : $"${Model.Price:F2}")</p>

                <p><strong>Every Student Can Enroll:</strong> @(Model.EveryStuCouldEnroll ? "Yes" : "No")</p>
                <p><strong>Auto-Issue Certificates:</strong> @(Model.AutoIssueCertificates ? "Yes" : "No")</p>
                <p>
                    <strong>Min Attendance %:</strong> @Model.MinAttendancePercentage |
                    <strong>Min Performance Score:</strong> @Model.MinPerformanceScore
                </p>
                @if (!string.IsNullOrEmpty(Model.CertificateTemplateTitle))
                {
                    <p><strong>Certificate Template:</strong> @Model.CertificateTemplateTitle</p>
                }

                <hr />
                <h6>Course Schedule</h6>
                @if (Model.Schedule.Any())
                {
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Day</th>
                                <th>Start Time</th>
                                <th>End Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.Schedule)
                            {
                                <tr>
                                    <td>@s.DayOfWeek</td>
                                    <td>@s.StartTime.ToString(@"hh\:mm")</td>
                                    <td>@s.EndTime.ToString(@"hh\:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                else
                {
                    <p>No schedule available.</p>
                }

                <hr />
                <h6>Lectures</h6>
                <div class="d-grid gap-2">
                    <a href="@Url.Action("Index", "Lecture", new { courseId = Model.Id })" class="btn btn-outline-primary">
                        <i class="bi bi-play-circle"></i> View Course Lectures
                    </a>
                </div>

                <hr />
                <h6>Instructors</h6>
                @if (Model.Instructors.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var i in Model.Instructors)
                        {
                            <li class="list-group-item">
                                <strong>@i.Name</strong> (@i.Email)
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p>No instructors assigned.</p>
                }

                <hr />
                <h6>Assignments</h6>
                @if (Model.Assignments != null && Model.Assignments.Any())
                {
                    <div class="list-group list-group-flush mb-3">
                        @foreach (var assignment in Model.Assignments)
                        {
                            <a asp-controller="Assignment" asp-action="Details" asp-route-id="@assignment.Id" 
                               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-1">@assignment.Title</h6>
                                    <small class="text-muted">Due: @assignment.DueDate.ToString("MMM dd, yyyy")</small>
                                </div>
                                <span class="badge bg-primary rounded-pill">
                                    <i class="bi bi-chevron-right"></i>
                                </span>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <p>No assignments available.</p>
                }

               
                <hr />
                <h6>Quizzes</h6>
                @if (Model.Quizzes != null && Model.Quizzes.Any())
                {
                    <div class="list-group list-group-flush mb-3">
                        @foreach (var quiz in Model.Quizzes)
                        {
                            <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <a asp-controller="Quiz" asp-action="Details" asp-route-id="@quiz.Id" class="text-decoration-none text-dark flex-grow-1">
                                    <div>
                                        <h6 class="mb-1">@quiz.Title</h6>
                                        <small class="text-muted">Duration: @quiz.DurationMinutes mins | Questions: @quiz.NumberOfQuestions</small>
                                    </div>
                                </a>
                                @if (User.IsInRole("Instructor") && ViewBag.EnrollmentStatus == "Approved")
                                {
                                    <div class="btn-group">
                                        <a asp-controller="Quiz" asp-action="Edit" asp-route-id="@quiz.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-controller="Quiz" asp-action="Delete" asp-route-id="@quiz.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <span class="badge bg-primary rounded-pill">
                                        <i class="bi bi-chevron-right"></i>
                                    </span>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p>No quizzes available.</p>
                }
<div class="mt-4 d-flex gap-2 flex-wrap">
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                            <i class="bi bi-pencil-square"></i> Edit Course
                        </a>
                        <a asp-controller="LectureSchedule" asp-action="Index" asp-route-courseId="@Model.Id" class="btn btn-secondary">
                            <i class="bi bi-calendar-week"></i> Manage Schedule
                        </a>
                    }

                    <!-- Assignment Upload Button for Instructors who are enrolled -->
                    @if (User.IsInRole("Instructor") && ViewBag.EnrollmentStatus == "Approved")
                    {
                        <a asp-controller="Assignment" asp-action="Create" asp-route-courseId="@Model.Id" class="btn btn-info">
                            <i class="bi bi-upload"></i> Upload Assignment
                        </a>
                                           <a asp-controller="Quiz" asp-action="Create" asp-route-courseId="@Model.Id" class="btn btn-warning">
                            <i class="bi bi-plus-circle"></i> Create Quiz
                        </a>
 }

                    @if (User.IsInRole("Student") || User.IsInRole("Instructor"))
                    {
                        <button id="enroll-btn"
                                class="btn @(ViewBag.EnrollmentStatus == "Approved" ? "btn-danger" : ViewBag.EnrollmentStatus == "Pending" ? "btn-secondary" : "btn-success")"
                                data-course-id="@Model.Id"
                                data-enrollment-status="@ViewBag.EnrollmentStatus"
                                @(ViewBag.EnrollmentStatus == "Pending" ? "disabled" : "")>
                            @if (ViewBag.EnrollmentStatus == "Approved")
                            {
                                @:<i class="bi bi-x-circle"></i> Unenroll
                            }
                            else if (ViewBag.EnrollmentStatus == "Pending")
                            {
                                @:<i class="bi bi-hourglass"></i> Pending Approval
                            }
                            else
                            {
                                @:<i class="bi bi-check-circle"></i> Enroll
                            }
                        </button>
                    }
@Html.AntiForgeryToken()

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const enrollBtn = document.getElementById("enroll-btn");
            if (!enrollBtn) return;

            enrollBtn.addEventListener("click", async function () {
                const courseId = this.dataset.courseId;
                const currentStatus = this.dataset.enrollmentStatus;
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                if (currentStatus === "Pending") return;

                this.disabled = true;
                this.innerHTML = `<span class="spinner-border spinner-border-sm"></span> Processing...`;

                try {
                    const isEnrolled = currentStatus === "Approved";
                    const endpoint = isEnrolled ? `/Course/Unenroll?courseId=${courseId}` : `/Course/Enroll?courseId=${courseId}`;
                    const response = await fetch(endpoint, {
                        method: "POST",
                        headers: {
                            "RequestVerificationToken": token
                        }
                    });

                    const result = await response.json();
                    if (!response.ok) throw new Error(result.message || "Something went wrong.");

                    if (result.success && !result.unenrolled) {
                        // Enrolled successfully
                        if (result.canEnrollImmediately !== false) {
                             // Approved immediately (e.g. Student)
                            this.dataset.enrollmentStatus = "Approved";
                            this.classList.remove("btn-success");
                            this.classList.add("btn-danger");
                            this.innerHTML = `<i class="bi bi-x-circle"></i> Unenroll`;
                            alert("? You have been enrolled successfully!");
                            
                            // Reload for instructors to see upload button
                             if (@(User.IsInRole("Instructor").ToString().ToLower())) {
                                location.reload();
                            }
                        } else {
                            // Pending approval (e.g. Instructor)
                            this.dataset.enrollmentStatus = "Pending";
                            this.classList.remove("btn-success");
                            this.classList.add("btn-secondary");
                            this.innerHTML = `<i class="bi bi-hourglass"></i> Pending Approval`;
                            this.disabled = true;
                            alert("? Your enrollment request has been sent for approval.");
                        }
                    }
                    else if (result.success && result.unenrolled) {
                        // Unenrolled successfully
                        this.dataset.enrollmentStatus = "None";
                        this.classList.remove("btn-danger");
                        this.classList.add("btn-success");
                        this.innerHTML = `<i class="bi bi-check-circle"></i> Enroll`;
                        alert("? You have been unenrolled.");

                        // Reload for instructors to hide upload button
                         if (@(User.IsInRole("Instructor").ToString().ToLower())) {
                            location.reload();
                        }
                    } else {
                        throw new Error(result.message || "Operation failed.");
                    }
                } catch (err) {
                    console.error(err);
                    alert("?? Error: " + err.message);
                    // Reset button state on error
                    if (currentStatus === "Approved") {
                         this.innerHTML = `<i class="bi bi-x-circle"></i> Unenroll`;
                    } else {
                         this.innerHTML = `<i class="bi bi-check-circle"></i> Enroll`;
                    }
                } finally {
                    if (this.dataset.enrollmentStatus !== "Pending") {
                        this.disabled = false;
                    }
                }
            });
        });
    </script>
}
