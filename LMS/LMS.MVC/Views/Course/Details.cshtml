@using Domain.Enums
@using LMS.MVC.Models.ViewModels.Course
@model ReadCourseViewModel

@{
    ViewData["Title"] = "Course Details";
}

<div class="page-header mb-4">
    <h2><i class="bi bi-book"></i> @Model.Name</h2>
</div>

<div class="row g-4">

    <div class="col-md-4">
        @if (!string.IsNullOrEmpty(Model.ThumbnailPath))
        {
            <div class="card mb-4 shadow-sm">
                <img src="@Model.ThumbnailPath" class="card-img-top" alt="Course Thumbnail" />
            </div>
        }

        <div class="card mb-4 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Course Stats</h5>
                <p class="card-text"><strong>Enrolled Students:</strong> @Model.EnrolledStudentsCount</p>
                <p class="card-text"><strong>Average Rating:</strong> @Model.AverageRating</p>
                <p class="card-text"><strong>Total Sessions:</strong> @Model.TotalSessions</p>
                <p class="card-text"><strong>Hours/Session:</strong> @Model.HoursPerSession</p>
                <p class="card-text"><strong>Days/Week:</strong> @Model.DaysPerWeek</p>
                <p class="card-text"><strong>Last Updated:</strong> @(Model.LastUpdate?.ToString("yyyy-MM-dd HH:mm") ?? "-")</p>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Course Information</h5>
                <p><strong>Course Code:</strong> @Model.CourseCode</p>
                <p><strong>Description:</strong> @Model.Description</p>
                <p><strong>Category:</strong> @Model.CategoryName</p>
                <p><strong>Level:</strong> @Model.Level</p>
                <p><strong>Language:</strong> @Model.Language</p>
                <p><strong>Credits:</strong> @Model.Credits</p>
                <p><strong>Delivery Mode:</strong> @Model.DeliveryMode</p>
                <p><strong>Status:</strong> @Model.Status</p>
                <p><strong>Start Date:</strong> @Model.StartDate| <strong>End Date:</strong> @Model.EndDate | <strong>Duration:</strong> @Model.DurationWeeks weeks</p>
                <p><strong>Price:</strong> @(Model.IsFree ? "Free" : $"${Model.Price:F2}")</p>
                <p><strong>Auto-Issue Certificates:</strong> @(Model.AutoIssueCertificates ? "Yes" : "No")</p>
                <p><strong>Min Attendance %:</strong> @Model.MinAttendancePercentage | <strong>Min Performance Score:</strong> @Model.MinPerformanceScore</p>
                @if (!string.IsNullOrEmpty(Model.CertificateTemplateTitle))
                {
                    <p><strong>Certificate Template:</strong> @Model.CertificateTemplateTitle</p>
                }

                <hr />

                <h6>Course Schedule</h6>
                @if (Model.Schedule.Any())
                {
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Day</th>
                                <th>Start Time</th>
                                <th>End Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.Schedule)
                            {
                                <tr>
                                    <td>@s.DayOfWeek</td>
                                    <td>@s.StartTime.ToString("HH:mm")</td>
                                    <td>@s.EndTime.ToString("HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p>No schedule available.</p>
                }

                <hr />
                <h6>Instructors</h6>
                @if (Model.Instructors.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var i in Model.Instructors)
                        {
                            <li class="list-group-item">
                                <strong>@i.Name</strong> (@i.Email)
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p>No instructors assigned.</p>
                }

                <div class="mt-4 d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="bi bi-pencil-square"></i> Edit Course
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Back to Courses
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
