@model IEnumerable<LMS.MVC.Models.ViewModels.Course.ReadCourseResult>

@{
    ViewData["Title"] = "Course Management";
}

<style>
    .badge-free {
        background-color: #28a745;
        color: white;
    }

    .badge-price {
        background-color: #007bff;
        color: white;
    }

    .badge-language {
        background-color: #6c757d;
        color: white;
    }

    .badge-open-enrollment {
        background-color: #17a2b8;
        color: white;
    }

    .card.course-card {
        border: 1px solid #e0e0e0;
        border-radius: 10px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .card.course-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

    .course-description {
        min-height: 60px;
    }

    .text-primary-custom {
        color: #007bff;
    }
</style>

<div class="page-header">
    @if (User.IsInRole("Admin"))
    {
        <div class="d-flex justify-content-between align-items-center">
            <h2>
                <i class="bi bi-book-half"></i> Course Management
            </h2>
            <a asp-controller="Course" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Create New Course
            </a>
        </div>
    }
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info text-center" role="alert">
        <i class="bi bi-info-circle"></i> No courses available. Create your first course to get started!
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var course in Model)
        {
            <div class="col-md-6 col-lg-4" id="course-@course.Id">
                <div class="card course-card h-100 d-flex flex-column">
                    @if (!string.IsNullOrEmpty(course.ThumbnailPath))
                    {
                        <img src="@course.ThumbnailPath" class="card-img-top" alt="@course.Name">
                    }
                <div class="card-header">
                    <h5 class="mb-0">@course.Name</h5>
                </div>
                <div class="card-body d-flex flex-column">
                    <p class="course-description">
                        @(string.IsNullOrEmpty(course.Description)
                                            ? "No description available"
                                            : (course.Description.Length > 120
                                            ? course.Description.Substring(0, 120) + "..."
                                            : course.Description))
                </p>

                        <div class="course-meta mb-3">
                            <div class="mb-2">
                                <i class="bi bi-translate text-primary-custom"></i>
                                <span class="badge badge-language">@course.Language</span>
                            </div>
                            <div class="mb-2">
                                <i class="bi bi-calendar-event text-primary-custom"></i>
                                <strong>Start:</strong> @course.StartDate.ToString("MMM dd, yyyy")
                            </div>
                            <div class="mb-2">
                                <i class="bi bi-calendar-check text-primary-custom"></i>
                                <strong>End:</strong> @course.EndDate.ToString("MMM dd, yyyy")
                            </div>

                    @if (course.Credits > 0)
                            {
                                <div class="mb-2">
                                    <i class="bi bi-award text-primary-custom"></i>
                                    <strong>Credits:</strong> @course.Credits
                                </div>
                            }

                            <!-- 🆕 Open Enrollment badge -->
                            @if (course.EveryStuCouldEnroll)
                            {
                                <div class="mb-2">
                                    <span class="badge badge-open-enrollment">
                                        <i class="bi bi-people"></i> Open Enrollment
                                    </span>
                                </div>
                            }
                        </div>

                        <div class="mt-auto">
                            @if (course.IsFree)
                            {
                                <span class="badge badge-free">
                                    <i class="bi bi-gift"></i> FREE
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-price">
                                    <i class="bi bi-currency-dollar"></i>@course.Price.ToString("N2")
                                </span>
                            }
                        </div>
                    </div>
                    <div class="card-footer bg-light border-top mt-auto">
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a href="@Url.Action("Details", new { id = course.Id })" class="btn btn-primary btn-sm">
                                <i class="bi bi-eye"></i> Details
                            </a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-controller="Course" asp-action="Edit" asp-route-id="@course.Id" class="btn btn-info btn-sm">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>
                                <button type="button" class="btn btn-outline-danger btn-sm"
                                        onclick="deleteCourse('@course.Id', '@course.Name')">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        async function deleteCourse(courseId, courseName) {
            if (!confirm(`Are you sure you want to delete "${courseName}"?`)) return;

            try {
                const response = await fetch(`/Course/Delete/${courseId}`, {
                    method: 'DELETE'
                });

                const result = await response.json();
                
                if (result.success) {
                    // Find the course card by ID and remove it with animation
                    const courseCard = document.getElementById(`course-${courseId}`);
                    if (courseCard) {
                        courseCard.style.transition = 'opacity 0.3s, transform 0.3s';
                        courseCard.style.opacity = '0';
                        courseCard.style.transform = 'scale(0.9)';
                        setTimeout(() => courseCard.remove(), 300);
                    } else {
                        location.reload();
                    }
                    // Optional: Show a toast or alert if you want, but the visual removal is often enough
                    // alert(result.message || 'Course deleted successfully!');
                } else {
                    alert(result.message || 'Failed to delete course.');
                }
            } catch (err) {
                console.error(err);
                alert('Error deleting course: ' + err.message);
            }
        }
    </script>
}
