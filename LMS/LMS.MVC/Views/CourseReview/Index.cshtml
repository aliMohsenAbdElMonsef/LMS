@model dynamic
@{
    ViewData["Title"] = "Course Reviews";
    var courseId = ViewBag.CourseId;
}

<div class="container py-5">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 animate-fade-in-up">
        <div>
            <h2><i class="bi bi-star"></i> Course Reviews</h2>
            <p class="text-secondary mb-0">See what students are saying</p>
        </div>
        @if (User.IsInRole("Student"))
        {
            <a href="@Url.Action("Create", "CourseReview", new { courseId })" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Write a Review
            </a>
        }
    </div>

    <div class="row">
        <div class="col-lg-8">
            <!-- Reviews List -->
            <div class="reviews-list">
                <!-- Review 1 -->
                <div class="card review-card mb-4 animate-fade-in-up">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="d-flex gap-3">
                                <img src="~/images/default-avatar.png" alt="User" class="rounded-circle" style="width: 50px; height: 50px;">
                                <div>
                                    <h6 class="mb-1">Sarah Johnson</h6>
                                    <div class="stars mb-1">
                                        <i class="bi bi-star-fill text-warning"></i>
                                        <i class="bi bi-star-fill text-warning"></i>
                                        <i class="bi bi-star-fill text-warning"></i>
                                        <i class="bi bi-star-fill text-warning"></i>
                                        <i class="bi bi-star-fill text-warning"></i>
                                    </div>
                                    <small class="text-muted">2 days ago</small>
                                </div>
                            </div>
                            @if (User.Identity.Name == "Sarah Johnson")
                            {
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-link" data-bs-toggle="dropdown">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" href="#"><i class="bi bi-pencil"></i> Edit</a></li>
                                        <li><a class="dropdown-item text-danger" href="#"><i class="bi bi-trash"></i> Delete</a></li>
                                    </ul>
                                </div>
                            }
                        </div>
                        <h6 class="mb-2">Excellent course for beginners!</h6>
                        <p class="mb-3">This course exceeded my expectations. The instructor explains complex concepts in a very clear and understandable way. The hands-on projects really helped solidify my understanding. Highly recommended!</p>
                        <div class="review-actions">
                            <button class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-hand-thumbs-up"></i> Helpful (24)
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Review 2 -->
                <div class="card review-card mb-4 animate-fade-in-up animate-delay-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="d-flex gap-3">
                                <img src="~/images/default-avatar.png" alt="User" class="rounded-circle" style="width: 50px; height: 50px;">
                                <div>
                                    <h6 class="mb-1">Mike Chen</h6>
                                    <div class="stars mb-1">
                                        <i class="bi bi-star-fill text-warning"></i>
                                        <i class="bi bi-star-fill text-warning"></i>
                                        <i class="bi bi-star-fill text-warning"></i>
                                        <i class="bi bi-star-fill text-warning"></i>
                                        <i class="bi bi-star text-warning"></i>
                                    </div>
                                    <small class="text-muted">1 week ago</small>
                                </div>
                            </div>
                        </div>
                        <h6 class="mb-2">Great content, well structured</h6>
                        <p class="mb-3">The course content is comprehensive and well-organized. I particularly enjoyed the practical examples and real-world projects. The only minor issue is that some videos could be a bit shorter.</p>
                        <div class="review-actions">
                            <button class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-hand-thumbs-up"></i> Helpful (18)
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Review 3 -->
                <div class="card review-card mb-4 animate-fade-in-up animate-delay-200">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="d-flex gap-3">
                                <img src="~/images/default-avatar.png" alt="User" class="rounded-circle" style="width: 50px; height: 50px;">
                                <div>
                                    <h6 class="mb-1">Emily Davis</h6>
                                    <div class="stars mb-1">
                                        <i class="bi bi-star-fill text-warning"></i>
                                        <i class="bi bi-star-fill text-warning"></i>
                                        <i class="bi bi-star-fill text-warning"></i>
                                        <i class="bi bi-star-fill text-warning"></i>
                                        <i class="bi bi-star-fill text-warning"></i>
                                    </div>
                                    <small class="text-muted">2 weeks ago</small>
                                </div>
                            </div>
                        </div>
                        <h6 class="mb-2">Perfect for career transition</h6>
                        <p class="mb-3">I was transitioning from a non-tech background and this course was perfect. The instructor is patient and thorough. The assignments helped me build a solid portfolio. I got my first web dev job 3 months after completing this course!</p>
                        <div class="review-actions">
                            <button class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-hand-thumbs-up"></i> Helpful (42)
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Pagination -->
            <nav aria-label="Reviews pagination">
                <ul class="pagination justify-content-center">
                    <li class="page-item disabled">
                        <a class="page-link" href="#"><i class="bi bi-chevron-left"></i></a>
                    </li>
                    <li class="page-item active"><a class="page-link" href="#">1</a></li>
                    <li class="page-item"><a class="page-link" href="#">2</a></li>
                    <li class="page-item"><a class="page-link" href="#">3</a></li>
                    <li class="page-item">
                        <a class="page-link" href="#"><i class="bi bi-chevron-right"></i></a>
                    </li>
                </ul>
            </nav>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Rating Summary -->
            <div class="card mb-4 animate-fade-in-up">
                <div class="card-body text-center">
                    <h2 class="display-3 mb-2">4.8</h2>
                    <div class="stars mb-2">
                        <i class="bi bi-star-fill text-warning" style="font-size: 1.5rem;"></i>
                        <i class="bi bi-star-fill text-warning" style="font-size: 1.5rem;"></i>
                        <i class="bi bi-star-fill text-warning" style="font-size: 1.5rem;"></i>
                        <i class="bi bi-star-fill text-warning" style="font-size: 1.5rem;"></i>
                        <i class="bi bi-star-half text-warning" style="font-size: 1.5rem;"></i>
                    </div>
                    <p class="text-muted mb-0">Based on 234 reviews</p>
                </div>
            </div>

            <!-- Rating Breakdown -->
            <div class="card animate-fade-in-up animate-delay-100">
                <div class="card-header">
                    <h6 class="mb-0">Rating Breakdown</h6>
                </div>
                <div class="card-body">
                    <div class="rating-breakdown">
                        <div class="d-flex align-items-center mb-2">
                            <span class="me-2">5 <i class="bi bi-star-fill text-warning small"></i></span>
                            <div class="progress flex-grow-1 me-2" style="height: 8px;">
                                <div class="progress-bar bg-warning" style="width: 75%"></div>
                            </div>
                            <span class="small text-muted">175</span>
                        </div>
                        <div class="d-flex align-items-center mb-2">
                            <span class="me-2">4 <i class="bi bi-star-fill text-warning small"></i></span>
                            <div class="progress flex-grow-1 me-2" style="height: 8px;">
                                <div class="progress-bar bg-warning" style="width: 15%"></div>
                            </div>
                            <span class="small text-muted">35</span>
                        </div>
                        <div class="d-flex align-items-center mb-2">
                            <span class="me-2">3 <i class="bi bi-star-fill text-warning small"></i></span>
                            <div class="progress flex-grow-1 me-2" style="height: 8px;">
                                <div class="progress-bar bg-warning" style="width: 6%"></div>
                            </div>
                            <span class="small text-muted">14</span>
                        </div>
                        <div class="d-flex align-items-center mb-2">
                            <span class="me-2">2 <i class="bi bi-star-fill text-warning small"></i></span>
                            <div class="progress flex-grow-1 me-2" style="height: 8px;">
                                <div class="progress-bar bg-warning" style="width: 3%"></div>
                            </div>
                            <span class="small text-muted">7</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <span class="me-2">1 <i class="bi bi-star-fill text-warning small"></i></span>
                            <div class="progress flex-grow-1 me-2" style="height: 8px;">
                                <div class="progress-bar bg-warning" style="width: 1%"></div>
                            </div>
                            <span class="small text-muted">3</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.review-card {
    border: none;
    border-radius: 1rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    transition: all 0.3s ease;
}

.review-card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
}

.stars i {
    font-size: 1rem;
}
</style>
