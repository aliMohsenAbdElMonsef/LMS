@model dynamic
@{
    ViewData["Title"] = "Write a Review";
    var courseId = ViewBag.CourseId;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card animate-fade-in-up">
                <div class="card-header">
                    <h4 class="mb-0"><i class="bi bi-star"></i> Write a Review</h4>
                </div>
                <div class="card-body">
                    <!-- Course Info -->
                    <div class="course-info mb-4 p-3 bg-light rounded">
                        <div class="d-flex align-items-center gap-3">
                            <img src="~/images/course-thumb.jpg" alt="Course" class="rounded" style="width: 80px; height: 80px; object-fit: cover;">
                            <div>
                                <h5 class="mb-1">Web Development Bootcamp</h5>
                                <p class="text-muted small mb-0">by John Smith</p>
                            </div>
                        </div>
                    </div>

                    <form method="post" asp-action="Create">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="CourseId" value="@courseId" />

                        <!-- Rating -->
                        <div class="mb-4">
                            <label class="form-label">Your Rating <span class="text-danger">*</span></label>
                            <div class="rating-input">
                                <input type="radio" name="Rating" id="star5" value="5" required>
                                <label for="star5" title="5 stars">
                                    <i class="bi bi-star-fill"></i>
                                </label>
                                
                                <input type="radio" name="Rating" id="star4" value="4">
                                <label for="star4" title="4 stars">
                                    <i class="bi bi-star-fill"></i>
                                </label>
                                
                                <input type="radio" name="Rating" id="star3" value="3">
                                <label for="star3" title="3 stars">
                                    <i class="bi bi-star-fill"></i>
                                </label>
                                
                                <input type="radio" name="Rating" id="star2" value="2">
                                <label for="star2" title="2 stars">
                                    <i class="bi bi-star-fill"></i>
                                </label>
                                
                                <input type="radio" name="Rating" id="star1" value="1">
                                <label for="star1" title="1 star">
                                    <i class="bi bi-star-fill"></i>
                                </label>
                            </div>
                            <small class="text-muted d-block mt-2">Click to rate</small>
                        </div>

                        <!-- Review Title -->
                        <div class="mb-3">
                            <label class="form-label">Review Title <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="Title" placeholder="Summarize your experience" required>
                        </div>

                        <!-- Review Content -->
                        <div class="mb-4">
                            <label class="form-label">Your Review <span class="text-danger">*</span></label>
                            <textarea class="form-control" name="Content" rows="6" placeholder="Share your thoughts about this course..." required></textarea>
                            <small class="text-muted">Minimum 50 characters</small>
                        </div>

                        <!-- Helpful Tips -->
                        <div class="alert alert-info mb-4">
                            <h6><i class="bi bi-lightbulb"></i> Tips for writing a great review:</h6>
                            <ul class="mb-0 small">
                                <li>Be specific about what you liked or didn't like</li>
                                <li>Mention the instructor's teaching style</li>
                                <li>Discuss the course content and materials</li>
                                <li>Share how the course helped you</li>
                            </ul>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-send"></i> Submit Review
                            </button>
                            <a href="@Url.Action("Details", "Course", new { id = courseId })" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.rating-input {
    display: flex;
    flex-direction: row-reverse;
    justify-content: flex-end;
    gap: 0.5rem;
}

.rating-input input {
    display: none;
}

.rating-input label {
    cursor: pointer;
    font-size: 2.5rem;
    color: #d1d5db;
    transition: all 0.2s ease;
}

.rating-input label:hover,
.rating-input label:hover ~ label,
.rating-input input:checked ~ label {
    color: #fbbf24;
}

.rating-input label:hover {
    transform: scale(1.1);
}
</style>
