@model LMS.MVC.Models.ViewModels.Account.LoginViewModel
@{
  Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/signup.css" rel="stylesheet" /> <!-- reuse same CSS -->
</head>
<body>
    <div class="main">
        <div class="welcome-text">
            <h1>Welcome back <br><span>3lmny</span></h1>
        </div>
        <div class="signup-form">
            <h2>Login</h2>
            <form asp-action="Login" method="post">
                <div asp-validation-summary="All" class="text-danger"></div>

                <input asp-for="EmailOrUserName" type="email" placeholder="Email" />
                <span asp-validation-for="EmailOrUserName" class="text-danger"></span>

                <input asp-for="Password" type="password" placeholder="Password" />
                <span asp-validation-for="Password" class="text-danger"></span>

                <button type="submit" class="btn-signup">Login</button>

                <div class="login-link">
                    Don't have an account? <a asp-action="SignUp">Sign up here</a>
                </div>
            </form>
        </div>
    </div>
</body>
</html>
