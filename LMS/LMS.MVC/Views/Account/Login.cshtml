@model LMS.MVC.Models.ViewModels.Account.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        :root {
            --primary-color: #7a4dd8;
            --secondary-color: #4b2d73;
            --white: #fff;
            --light-purple: #ede7f6;
            --border-radius: 12px;
            --shadow-md: 0 0.5rem 1rem rgba(0, 0, 0, 0.1);
        }

        body {
            background: linear-gradient(135deg, #f8f5ff, #ede7f6);
            font-family: "Poppins", sans-serif;
            margin: 0;
            padding: 0;
        }

        .main {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            position: relative;
            overflow: hidden;
        }

            .main > div {
                background: var(--white);
                box-shadow: var(--shadow-md);
                border-radius: 20px;
                display: flex;
                flex-wrap: wrap;
                overflow: hidden;
                max-width: 900px;
                width: 100%;
            }

        .welcome-text {
            flex: 1;
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            color: var(--white);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            padding: 4rem 2rem;
            text-align: center;
        }

            .welcome-text h1 {
                font-size: 2.5rem;
                font-weight: 700;
                margin: 0;
            }

            .welcome-text span {
                color: #ffdf6c;
            }

        .signup-form {
            flex: 1;
            padding: 3rem;
        }

            .signup-form h2 {
                font-weight: 700;
                color: var(--secondary-color);
                margin-bottom: 2rem;
                text-align: center;
            }

        .form-control {
            border-radius: 10px;
            border: 2px solid #e6e2f3;
            padding: 0.75rem 1rem;
            transition: all 0.3s ease;
            width: 100%;
            margin-bottom: 1rem;
        }

            .form-control:focus {
                border-color: var(--primary-color);
                box-shadow: 0 0 0 0.2rem rgba(122, 77, 216, 0.15);
                outline: none;
            }

        input[type="password"] {
            border-radius: 10px;
            border: 2px solid #e6e2f3;
            padding: 0.75rem 1rem;
            transition: all 0.3s ease;
            width: 100%;
            margin-bottom: 1rem;
        }

            input[type="password"]:focus {
                border-color: var(--primary-color);
                box-shadow: 0 0 0 0.2rem rgba(122, 77, 216, 0.15);
                outline: none;
            }

        .form-check-label {
            font-weight: 500;
            color: #555;
        }

        .btn-signup {
            width: 100%;
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            border: none;
            border-radius: 10px;
            padding: 0.875rem;
            color: var(--white);
            font-weight: 600;
            font-size: 1.05rem;
            transition: all 0.3s ease;
            cursor: pointer;
        }

            .btn-signup:hover {
                background: var(--primary-color);
                box-shadow: 0 8px 20px rgba(122, 77, 216, 0.3);
            }

        .login-link {
            text-align: center;
            margin-top: 1rem;
        }

            .login-link a {
                color: var(--primary-color);
                font-weight: 600;
                text-decoration: none;
            }

                .login-link a:hover {
                    text-decoration: underline;
                }

        .text-danger {
            color: #dc3545;
            font-size: 0.875rem;
            display: block;
            margin-top: -0.5rem;
            margin-bottom: 0.5rem;
        }

        @@media (max-width: 768px) {
            .main > div

        {
            flex-direction: column;
        }

        .welcome-text {
            padding: 2rem;
        }

            .welcome-text h1 {
                font-size: 2rem;
            }

        .signup-form {
            padding: 2rem;
        }

        }
    </style>
</head>
<body>
    <div class="main">
        <div>
            <div class="welcome-text">
                <h1>Welcome back <br><span>3lmny</span></h1>
            </div>
            <div class="signup-form">
                <h2>Login</h2>
                <form asp-action="Login" method="post">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <input asp-for="EmailOrUserName" type="text" placeholder="Email or Username" class="form-control" />
                    <span asp-validation-for="EmailOrUserName" class="text-danger"></span>
                    <input asp-for="Password" type="password" placeholder="Password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                    <div class="form-check mb-3 mt-3">
                        <input asp-for="rememberMe" class="form-check-input" type="checkbox" id="RememberMe" />
                        <label class="form-check-label" for="RememberMe">Remember Me</label>
                    </div>
                    <button type="submit" class="btn-signup">Login</button>
                </form>
                <div class="login-link mt-3 text-center">
                    <a asp-action="ForgotPassword" asp-controller="Account">Forgot your password?</a>
                </div>
                <div class="login-link mt-2 text-center">
                    Don't have an account? <a asp-action="SignUp" asp-controller="Account">Sign up here</a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>