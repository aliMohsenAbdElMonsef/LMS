@using LMS.MVC.Models.ViewModels.Account
@model SignUpViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        :root {
            --primary-color: #7a4dd8;
            --secondary-color: #4b2d73;
            --white: #fff;
            --light-purple: #ede7f6;
            --border-radius: 12px;
            --shadow-md: 0 0.5rem 1rem rgba(0, 0, 0, 0.1);
        }

        body {
            background: linear-gradient(135deg, #f8f5ff, #ede7f6);
            font-family: "Poppins", sans-serif;
            margin: 0;
            padding: 0;
        }

        .main {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            position: relative;
            overflow: hidden;
            padding: 2rem 0;
        }

            .main > div {
                background: var(--white);
                box-shadow: var(--shadow-md);
                border-radius: 20px;
                display: flex;
                flex-wrap: wrap;
                overflow: hidden;
                max-width: 900px;
                width: 100%;
            }

        .welcome-text {
            flex: 1;
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            color: var(--white);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            padding: 4rem 2rem;
            text-align: center;
        }

            .welcome-text h1 {
                font-size: 2.5rem;
                font-weight: 700;
                margin: 0;
            }

            .welcome-text span {
                color: #ffdf6c;
            }

        .signup-form {
            flex: 1;
            padding: 3rem;
            max-height: 90vh;
            overflow-y: auto;
        }

            .signup-form h2 {
                font-weight: 700;
                color: var(--secondary-color);
                margin-bottom: 2rem;
                text-align: center;
            }

        input[type="text"],
        input[type="email"],
        input[type="password"] {
            border-radius: 10px;
            border: 2px solid #e6e2f3;
            padding: 0.75rem 1rem;
            transition: all 0.3s ease;
            width: 100%;
            margin-bottom: 1rem;
        }

            input[type="text"]:focus,
            input[type="email"]:focus,
            input[type="password"]:focus {
                border-color: var(--primary-color);
                box-shadow: 0 0 0 0.2rem rgba(122, 77, 216, 0.15);
                outline: none;
            }

        .role-group {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1rem;
            padding: 0.5rem 0;
        }

            .role-group input[type="radio"] {
                width: auto;
                margin: 0;
            }

            .role-group label {
                font-weight: 500;
                color: #555;
                margin: 0;
                cursor: pointer;
            }

        .file-input-group {
            margin-bottom: 1rem;
        }

        .custom-file-upload {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 0.75rem 1rem;
            border: 2px solid #e6e2f3;
            border-radius: 10px;
            transition: all 0.3s ease;
        }

            .custom-file-upload:hover {
                border-color: var(--primary-color);
            }

        #file-chosen {
            flex: 1;
            color: #666;
            font-size: 0.95rem;
        }

        .upload-btn {
            background: var(--primary-color);
            color: var(--white);
            padding: 0.5rem 1.5rem;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
            margin: 0;
        }

            .upload-btn:hover {
                background: var(--secondary-color);
                box-shadow: 0 4px 12px rgba(122, 77, 216, 0.3);
            }

        .btn-signup {
            width: 100%;
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            border: none;
            border-radius: 10px;
            padding: 0.875rem;
            color: var(--white);
            font-weight: 600;
            font-size: 1.05rem;
            transition: all 0.3s ease;
            cursor: pointer;
            margin-top: 1rem;
        }

            .btn-signup:hover {
                background: var(--primary-color);
                box-shadow: 0 8px 20px rgba(122, 77, 216, 0.3);
            }

        .login-link {
            text-align: center;
            margin-top: 1.5rem;
        }

            .login-link a {
                color: var(--primary-color);
                font-weight: 600;
                text-decoration: none;
            }

                .login-link a:hover {
                    text-decoration: underline;
                }

        .text-danger {
            color: #dc3545;
            font-size: 0.875rem;
            display: block;
            margin-top: -0.5rem;
            margin-bottom: 0.5rem;
        }

        @@media (max-width: 768px) {
            .main > div

        {
            flex-direction: column;
        }

        .welcome-text {
            padding: 2rem;
        }

            .welcome-text h1 {
                font-size: 2rem;
            }

        .signup-form {
            padding: 2rem;
            max-height: none;
        }

        }
    </style>
</head>
<body>
    <div class="main">
        <div>
            <div class="welcome-text">
                <h1>Welcome to our website <br><span>3lmny</span></h1>
            </div>
            <div class="signup-form">
                <h2>Sign Up</h2>
                <form asp-action="SignUp" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <input asp-for="FirstName" type="text" placeholder="First Name" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                    <input asp-for="LastName" type="text" placeholder="Last Name" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                    <input asp-for="Email" type="email" placeholder="Email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                    <input asp-for="Password" type="password" placeholder="Password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                    <input asp-for="ConfirmPassword" type="password" placeholder="Confirm Password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    <input asp-for="UserName" type="text" placeholder="User Name" />
                    <span asp-validation-for="UserName" class="text-danger"></span>
                    <div class="role-group">
                        <input asp-for="ApplyAs" type="radio" id="instructor" value="1" />
                        <label for="instructor">Instructor</label>
                        <input asp-for="ApplyAs" type="radio" id="student" value="2" checked />
                        <label for="student">Student</label>
                        <span asp-validation-for="ApplyAs" class="text-danger"></span>
                    </div>
                    <div class="file-input-group">
                        <div class="custom-file-upload">
                            <span id="file-chosen">Choose profile photo</span>
                            <label for="UserImage" class="upload-btn">Choose File</label>
                            <input asp-for="UserImage" type="file" accept="image/*" id="UserImage" hidden />
                        </div>
                        <span asp-validation-for="UserImage" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn-signup">Sign Up</button>
                    <div class="login-link">
                        Already have an account? <a asp-action="Login">Login here</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <script>
        const userImageInput = document.getElementById("UserImage");
        const fileChosenText = document.getElementById("file-chosen");
        userImageInput.addEventListener("change", function () {
            if (this.files && this.files.length > 0) {
                fileChosenText.textContent = this.files[0].name;
            } else {
                fileChosenText.textContent = "Choose profile photo";
            }
        });
    </script>
</body>
</html>