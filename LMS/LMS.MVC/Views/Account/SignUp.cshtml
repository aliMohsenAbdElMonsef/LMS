@using LMS.MVC.Models.ViewModels.Account
@model SignUpViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/signup.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <div class="main">
        <div class="welcome-text">
            <h1>Welcome to our website <br><span>3lmny</span></h1>
        </div>
        <div class="signup-form">
            <h2>Sign Up</h2>
            <form asp-action="SignUp" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="All" class="text-danger"></div>
                <input asp-for="FirstName" type="text" placeholder="First Name" />
                <span asp-validation-for="FirstName" class="text-danger"></span>

                <input asp-for="LastName" type="text" placeholder="Last Name" />
                <span asp-validation-for="LastName" class="text-danger"></span>

                <input asp-for="Email" type="email" placeholder="Email" />
                <span asp-validation-for="Email" class="text-danger"></span>

                <div class="password-container">
                    <input asp-for="Password" type="password" placeholder="Password" id="password-field" />
                    <i class="fa fa-eye toggle-password" onclick="togglePassword('password-field', this)"></i>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>

                <div class="password-container">
                    <input asp-for="ConfirmPassword" type="password" placeholder="Confirm Password" id="confirm-password-field" />
                    <i class="fa fa-eye toggle-password" onclick="togglePassword('confirm-password-field', this)"></i>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>

                <input asp-for="UserName" type="text" placeholder="User Name" />
                <span asp-validation-for="UserName" class="text-danger"></span>

                <div class="role-group">
                    <input asp-for="ApplyAs" type="radio"  id="instructor" value = "1"/>
                    <label for="instructor">Instructor</label>
                    <input asp-for="ApplyAs" type="radio" id="student" value = "2" checked />
                    <label for="student">Student</label>
                    <span asp-validation-for="ApplyAs" class="text-danger"></span>
                </div>

                <div class="file-input-group">
                    <div class="custom-file-upload">
                        <span id="file-chosen">Choose profile photo</span>
                        <label for="UserImage" class="upload-btn">Choose File</label>
                        <input asp-for="UserImage" type="file" accept="image/*" id="UserImage" hidden />
                    </div>

                    <span asp-validation-for="UserImage" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-signup">Sign Up</button>

                <div class="login-link">
                    Already have an account? <a asp-action="Login">Login here</a>
                </div>
            </form>
        </div>
    </div>
    <script>
        const userImageInput = document.getElementById("UserImage");
        const fileChosenText = document.getElementById("file-chosen");

        userImageInput.addEventListener("change", function () {
            if (this.files && this.files.length > 0) {
                fileChosenText.textContent = this.files[0].name;
            } else {
                fileChosenText.textContent = "Choose profile photo";
            }
        });

        function togglePassword(fieldId, icon) {
            const passwordField = document.getElementById(fieldId);
            const type = passwordField.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordField.setAttribute('type', type);
            
            // Toggle the eye icon
            icon.classList.toggle('fa-eye');
            icon.classList.toggle('fa-eye-slash');
        }
    </script>

</body>
</html>